<Project>
  <!-- Graphite is an opt-in browser renderer. The browser head needs its released
       managed/native API together; shared libraries and other heads keep the
       repository's existing Skia and HarfBuzz package versions. -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" VersionOverride="4.156.0" />
    <PackageReference Include="SkiaSharp.HarfBuzz" VersionOverride="4.156.0" />
    <PackageReference Include="SkiaSharp.Resources" VersionOverride="4.156.0" />
    <PackageReference Include="SkiaSharp.SceneGraph" VersionOverride="4.156.0" />
    <PackageReference Include="SkiaSharp.Skottie" VersionOverride="4.156.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" VersionOverride="4.156.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" VersionOverride="4.156.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" VersionOverride="4.156.0" />
    <PackageReference Update="SkiaSharp.NativeAssets.WebAssembly" VersionOverride="4.156.0" />
    <PackageReference Include="HarfBuzzSharp" VersionOverride="14.4.0.100" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" VersionOverride="14.4.0.100" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" VersionOverride="14.4.0.100" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" VersionOverride="14.4.0.100" />
    <PackageReference Update="HarfBuzzSharp.NativeAssets.WebAssembly" VersionOverride="14.4.0.100" />
    <EmbeddedResource Include="Platforms/WebAssembly/Rendering/WebGpuGraphiteCanvas.js"
                      LogicalName="UnoDraw.WebGpuGraphiteCanvas.source" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Uno7 and Skia4.156 ship the same Dawn v20260624.223603 C ABI. Uno adds
         its device/texture import exports to that port's JavaScript. Loading
         both package copies redeclares the generated ABI tables, so let Uno
         supply the sole JS port and add Skia's native archive explicitly. -->
    <ShouldIncludeNativeSkiaSharp>false</ShouldIncludeNativeSkiaSharp>
    <WasmBuildNative>true</WasmBuildNative>
    <EmccExtraLDFlags>$(EmccExtraLDFlags) -s USE_WEBGL2=1</EmccExtraLDFlags>
  </PropertyGroup>

  <!-- Select after all SDK defaults are known. Evaluation-time selection here
       would see an empty WasmEnableSIMD before BrowserWasmApp.targets is imported. -->
  <Target Name="SelectUnoDrawBrowserSkiaNativeLibrary" BeforeTargets="PrepareInputsForWasmBuild">
    <PropertyGroup>
      <UnoDrawSkiaNativeVariant Condition="'$(WasmEnableThreads)' == 'true'">mt</UnoDrawSkiaNativeVariant>
      <UnoDrawSkiaNativeVariant Condition="'$(WasmEnableThreads)' != 'true'">st</UnoDrawSkiaNativeVariant>
      <UnoDrawSkiaNativeVariant Condition="'$(WasmEnableSIMD)' == 'true'">$(UnoDrawSkiaNativeVariant),simd</UnoDrawSkiaNativeVariant>
      <UnoDrawSkiaNativeLibrary>$(SkiaSharpStaticLibraryPath)/3.1.56/$(UnoDrawSkiaNativeVariant)/libSkiaSharp.a</UnoDrawSkiaNativeLibrary>
    </PropertyGroup>
    <Error Condition="'$(SkiaSharpStaticLibraryPath)' == '' or !Exists('$(UnoDrawSkiaNativeLibrary)')"
           Text="The browser Graphite renderer requires SkiaSharp4.156.0's matching .NET10 native archive: $(UnoDrawSkiaNativeLibrary)" />
    <ItemGroup>
      <NativeFileReference Include="$(UnoDrawSkiaNativeLibrary)" />
    </ItemGroup>
    <Message Importance="High" Text="UnoDraw browser Skia native: $(UnoDrawSkiaNativeLibrary); Dawn JavaScript owner: Uno.WinUI.Composition.WebGpu." />
  </Target>
</Project>
