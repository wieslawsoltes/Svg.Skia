<UserControl x:Class="Svg.Editor.Skia.Uno.SvgEditorWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Svg.Editor.Skia.Uno"
             IsTabStop="True" AllowDrop="True" DragOver="Workspace_DragOver" Drop="Workspace_Drop"
             KeyDown="Workspace_KeyDown" KeyUp="Workspace_KeyUp">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WorkspaceBackground" Color="#F3F3F7" />
          <SolidColorBrush x:Key="PanelBackground" Color="#FCFCFE" />
          <SolidColorBrush x:Key="PanelBorder" Color="#E2E2EB" />
          <SolidColorBrush x:Key="MutedForeground" Color="#71717F" />
          <SolidColorBrush x:Key="SoftAccent" Color="#EEEBFF" />
          <SolidColorBrush x:Key="AccentForeground" Color="#6554C7" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WorkspaceBackground" Color="#19191F" />
          <SolidColorBrush x:Key="PanelBackground" Color="#222229" />
          <SolidColorBrush x:Key="PanelBorder" Color="#35353F" />
          <SolidColorBrush x:Key="MutedForeground" Color="#A6A6B4" />
          <SolidColorBrush x:Key="SoftAccent" Color="#36304F" />
          <SolidColorBrush x:Key="AccentForeground" Color="#BAAEFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <PathIcon x:Key="RectangleToolIcon" Data="M2,3 H22 V21 H2 Z M4,5 V19 H20 V5 Z" />
      <Style x:Key="RailButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
      </Style>
      <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="100" />
        <Setter Property="Foreground" Value="{ThemeResource MutedForeground}" />
        <Setter Property="Margin" Value="0,8,0,4" />
      </Style>
      <Style x:Key="CompactButton" TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="7" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid x:Name="WorkspaceRoot" Background="{ThemeResource WorkspaceBackground}">
      <Grid.RowDefinitions>
        <RowDefinition Height="56" />
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
        <RowDefinition Height="28" />
      </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{ThemeResource PanelBackground}" BorderBrush="{ThemeResource PanelBorder}" BorderThickness="0,0,0,1">
      <Grid Padding="16,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Background="#7061DC" Width="30" Height="30" CornerRadius="9">
            <TextBlock Text="u" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
          </Border>
          <TextBlock x:Name="BrandTitle" Text="UnoDraw" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Border x:Name="MenuDivider" Width="1" Height="22" Background="{ThemeResource PanelBorder}" Margin="10,0" />
          <MenuBar x:Name="WorkspaceMenu" Background="Transparent" VerticalAlignment="Center" />
          <Button x:Name="CompactMenuButton" Content="Menu" Visibility="Collapsed" Style="{StaticResource CompactButton}">
            <Button.Flyout><MenuFlyout x:Name="CompactMenu" /></Button.Flyout>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Style="{StaticResource CompactButton}" Click="Command_Click" Tag="commands" ToolTipService.ToolTip="Search commands (Ctrl+K)">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE721;" FontSize="13" /><TextBlock x:Name="CommandsLabel" Text="Commands" /><TextBlock x:Name="CommandsShortcut" Text="Ctrl K" Opacity="0.5" FontSize="11" /></StackPanel>
          </Button>
          <Button x:Name="ThemeButton" Style="{StaticResource CompactButton}" Tag="theme" Click="Command_Click" ToolTipService.ToolTip="Switch light and dark theme"><FontIcon Glyph="&#xE708;" FontSize="15" /></Button>
          <Button Style="{StaticResource CompactButton}" Tag="save" Click="Command_Click" Content="Save" />
          <Button x:Name="ExportButton" Style="{StaticResource CompactButton}" Tag="export" Click="Command_Click" Content="Export" Background="#7061DC" Foreground="White" BorderThickness="0" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Background="{ThemeResource PanelBackground}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TabView x:Name="DocumentTabs" IsAddTabButtonVisible="True" TabWidthMode="SizeToContent"
               AddTabButtonClick="DocumentTabs_AddTabButtonClick" SelectionChanged="DocumentTabs_SelectionChanged"
               TabCloseRequested="DocumentTabs_TabCloseRequested" CanDragTabs="False" CanReorderTabs="True" />
      <TextBlock x:Name="WorkspaceLabel" Grid.Column="1" Text="SVG WORKSPACE" CharacterSpacing="160" FontSize="10" Foreground="{ThemeResource MutedForeground}" VerticalAlignment="Center" Margin="16,0" />
    </Grid>
    <Grid Grid.Row="2" x:Name="EditorBody">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="64" />
        <ColumnDefinition Width="228" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="292" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{ThemeResource PanelBackground}" BorderBrush="{ThemeResource PanelBorder}" BorderThickness="0,1,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ToolRail" Spacing="5" HorizontalAlignment="Center" Margin="0,12" />
        </ScrollViewer>
      </Border>
      <Border x:Name="OutlinePanel" Grid.Column="1" Background="{ThemeResource PanelBackground}" BorderBrush="{ThemeResource PanelBorder}" BorderThickness="0,1,1,0">
        <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
          <Grid Padding="16,16,12,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
            <TextBlock Text="Document" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource CompactButton}" Tag="layer" Click="Command_Click" ToolTipService.ToolTip="New layer"><FontIcon Glyph="&#xE710;" FontSize="12" /></Button>
          </Grid>
          <TextBox Grid.Row="1" x:Name="OutlineSearch" PlaceholderText="Find objects…" Margin="12,0,12,8" TextChanged="OutlineSearch_TextChanged" />
          <TreeView Grid.Row="2" x:Name="DocumentOutline" SelectionMode="Single" ItemInvoked="DocumentOutline_ItemInvoked" CanDragItems="False" CanReorderItems="False" />
          <Border Grid.Row="3" BorderBrush="{ThemeResource PanelBorder}" BorderThickness="0,1,0,0" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="DOCUMENT RESOURCES" Style="{StaticResource SectionLabel}" />
              <ComboBox x:Name="ResourceList" HorizontalAlignment="Stretch" PlaceholderText="Gradients, patterns and symbols" SelectionChanged="ResourceList_SelectionChanged" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Style="{StaticResource CompactButton}" Tag="gradient" Click="Command_Click" Content="Gradient" />
                <Button Style="{StaticResource CompactButton}" Tag="symbol" Click="Command_Click" Content="Symbol" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Grid.Row="4" Background="{ThemeResource SoftAccent}" CornerRadius="10" Margin="12,0,12,12" Padding="12">
            <StackPanel Spacing="5">
              <TextBlock Text="Room for your next idea." FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentForeground}" />
              <TextBlock Text="Draw with R, E, P or B. Hold Space to explore the canvas." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource MutedForeground}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <Grid Grid.Column="2" x:Name="CanvasContainer" BorderBrush="{ThemeResource PanelBorder}" BorderThickness="0,1,0,0">
        <local:SvgEditorCanvas x:Name="Canvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12" Padding="6" CornerRadius="10" Background="{ThemeResource PanelBackground}" BorderBrush="{ThemeResource PanelBorder}" BorderThickness="1">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Style="{StaticResource CompactButton}" Tag="undo" Click="Command_Click" ToolTipService.ToolTip="Undo (Ctrl+Z)"><FontIcon Glyph="&#xE7A7;" FontSize="14" /></Button>
            <Button Style="{StaticResource CompactButton}" Tag="redo" Click="Command_Click" ToolTipService.ToolTip="Redo (Ctrl+Shift+Z)"><FontIcon Glyph="&#xE7A6;" FontSize="14" /></Button>
            <Border Width="1" Margin="5,3" Background="{ThemeResource PanelBorder}" />
            <Button Style="{StaticResource CompactButton}" Tag="grid" Click="Command_Click" Content="Grid" ToolTipService.ToolTip="Show grid" />
            <ToggleButton x:Name="SnapToggle" Content="Snap" Click="SnapToggle_Click" Padding="10,5" CornerRadius="7" MinHeight="32" ToolTipService.ToolTip="Snap geometry to the document grid" />
            <Button Style="{StaticResource CompactButton}" Tag="fit" Click="Command_Click" Content="Fit" ToolTipService.ToolTip="Fit artboard (Shift+1)" />
          </StackPanel>
        </Border>
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Background="{ThemeResource PanelBackground}" BorderBrush="{ThemeResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="4">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Style="{StaticResource CompactButton}" Tag="zoomout" Click="Command_Click" Content="−" />
            <Button x:Name="ZoomLabel" Style="{StaticResource CompactButton}" Tag="zoom100" Click="Command_Click" Content="100%" MinWidth="62" />
            <Button Style="{StaticResource CompactButton}" Tag="zoomin" Click="Command_Click" Content="+" />
          </StackPanel>
        </Border>
      </Grid>
      <Border x:Name="InspectorPanel" Grid.Column="3" Background="{ThemeResource PanelBackground}" BorderBrush="{ThemeResource PanelBorder}" BorderThickness="1,1,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16" Spacing="12">
            <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
              <TextBlock Text="Design" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" x:Name="SelectionBadge" Text="Artboard" FontSize="11" Foreground="{ThemeResource MutedForeground}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="SelectionName" Text="Your canvas" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <StackPanel x:Name="InspectorContent" Spacing="10" />
            <Border Height="1" Background="{ThemeResource PanelBorder}" />
            <TextBlock Text="SVG ATTRIBUTES" Style="{StaticResource SectionLabel}" />
            <TextBox x:Name="AttributeSearch" PlaceholderText="Filter attributes…" TextChanged="AttributeSearch_TextChanged" />
            <StackPanel x:Name="AttributeFields" Spacing="8" />
            <Button Tag="source" Click="Command_Click" Content="Edit SVG source" HorizontalAlignment="Stretch" Style="{StaticResource CompactButton}" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="{ThemeResource PanelBackground}" BorderBrush="{ThemeResource PanelBorder}" BorderThickness="0,1,0,0">
      <Grid Padding="14,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Ready to create" FontSize="11" Foreground="{ThemeResource MutedForeground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" x:Name="PositionText" FontSize="11" Foreground="{ThemeResource MutedForeground}" VerticalAlignment="Center" Margin="16,0" />
        <TextBlock Grid.Column="2" Text="Svg.Skia · Direct canvas" FontSize="11" Foreground="{ThemeResource MutedForeground}" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
