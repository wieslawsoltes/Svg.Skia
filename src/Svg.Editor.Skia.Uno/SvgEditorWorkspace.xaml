<UserControl x:Class="Svg.Editor.Skia.Uno.SvgEditorWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Svg.Editor.Skia.Uno"
             IsTabStop="True" AllowDrop="True" DragOver="Workspace_DragOver" Drop="Workspace_Drop"
             KeyDown="Workspace_KeyDown" KeyUp="Workspace_KeyUp">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><local:StudioThemeResources /></ResourceDictionary.MergedDictionaries>
      <Style x:Key="StudioOutlineContainer" TargetType="TreeViewItem">
        <Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="0,0,4,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="FontSize" Value="11" />
      </Style>
      <DataTemplate x:Key="StudioOutlineRowTemplate" x:DataType="TreeViewNode">
        <local:StudioLayerRow Element="{Binding Content.Element}" ActionRequested="LayerRow_ActionRequested" />
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid x:Name="WorkspaceRoot" Background="{ThemeResource StudioCanvas}">
    <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="40" /><RowDefinition Height="*" /><RowDefinition Height="30" /></Grid.RowDefinitions>
    <Border Background="{ThemeResource StudioHeader}" BorderBrush="{ThemeResource StudioDivider}" BorderThickness="0,0,0,1">
      <Grid Padding="8,0" ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Background="{ThemeResource StudioSelection}" Width="25" Height="25" CornerRadius="5"><TextBlock Text="u" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource StudioAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" /></Border>
          <TextBlock x:Name="BrandTitle" Text="UnoDraw" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource StudioForeground}" />
          <Border x:Name="MenuDivider" Width="1" Height="18" Background="{ThemeResource StudioDivider}" Margin="3,0" />
          <MenuBar x:Name="WorkspaceMenu" Background="Transparent" FontSize="12" VerticalAlignment="Center" />
          <Button x:Name="CompactMenuButton" Content="Menu" Visibility="Collapsed" Style="{StaticResource CompactButton}"><Button.Flyout><MenuFlyout x:Name="CompactMenu" /></Button.Flyout></Button>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <ComboBox x:Name="WorkspacePresetPicker" Width="130" MinHeight="28" Padding="8,3" AutomationProperties.Name="Workspace layout" SelectionChanged="WorkspacePreset_SelectionChanged">
            <x:String>Essentials</x:String><x:String>Drawing</x:String><x:String>Typography</x:String>
          </ComboBox>
          <Button Style="{StaticResource CompactButton}" Click="Command_Click" Tag="commands" ToolTipService.ToolTip="Search commands (Ctrl+K)">
            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE721;" FontSize="12" /><TextBlock x:Name="CommandsLabel" Text="Search" /><TextBlock x:Name="CommandsShortcut" Text="Ctrl K" Foreground="{ThemeResource StudioMuted}" FontSize="10" /></StackPanel>
          </Button>
          <Button x:Name="ThemeButton" Style="{StaticResource CompactButton}" Tag="theme" Click="Command_Click" ToolTipService.ToolTip="Switch theme"><FontIcon Glyph="&#xE708;" FontSize="13" /></Button>
          <Button Style="{StaticResource CompactButton}" Tag="save" Click="Command_Click" Content="Save" />
          <Button x:Name="ExportButton" Style="{StaticResource StudioPrimaryButtonStyle}" MinHeight="28" Padding="10,3" Tag="export" Click="Command_Click" Content="Export" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{ThemeResource StudioSurface}" BorderBrush="{ThemeResource StudioDivider}" BorderThickness="0,0,0,1">
      <Grid ColumnSpacing="8" Padding="8,3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="ContextSelectionLabel" Text="No selection" FontSize="11" MinWidth="80" MaxWidth="130" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource StudioMuted}" VerticalAlignment="Center" />
        <ScrollViewer Grid.Column="1" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ContextFields" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" />
        </ScrollViewer>
        <local:StudioIconButton Grid.Column="2" Label="Panels and workspace" Tag="workspacepanels" Click="Command_Click" Content="☷" />
      </Grid>
    </Border>
    <Grid Grid.Row="2" x:Name="EditorBody">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ToolColumn" Width="68" /><ColumnDefinition x:Name="LeftDockColumn" Width="0" />
        <ColumnDefinition x:Name="LeftSplitterColumn" Width="0" /><ColumnDefinition Width="*" />
        <ColumnDefinition Width="34" /><ColumnDefinition x:Name="RightSplitterColumn" Width="6" /><ColumnDefinition x:Name="RightDockColumn" Width="312" />
      </Grid.ColumnDefinitions>
      <Border Background="{ThemeResource StudioHeader}" BorderBrush="{ThemeResource StudioDivider}" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="8" Margin="3,8">
          <local:StudioWrapPanel x:Name="ToolRail" Spacing="2" />
          <Border Height="1" Background="{ThemeResource StudioDivider}" />
          <StackPanel x:Name="ToolPaintShelf" Spacing="4" />
          <Button Tag="help" Click="Command_Click" Content="?" Style="{StaticResource StudioQuietButtonStyle}" MinHeight="28" ToolTipService.ToolTip="Tools and shortcuts" />
        </StackPanel></ScrollViewer>
      </Border>
      <local:StudioDockGroup x:Name="LeftDock" Grid.Column="1" />
      <local:StudioSplitter x:Name="LeftDockSplitter" Grid.Column="2" />
      <Grid Grid.Column="3" x:Name="CanvasContainer">
        <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /><RowDefinition x:Name="BottomSplitterRow" Height="0" /><RowDefinition x:Name="BottomDockRow" Height="0" /></Grid.RowDefinitions>
        <TabView x:Name="DocumentTabs" IsAddTabButtonVisible="True" TabWidthMode="SizeToContent" AddTabButtonClick="DocumentTabs_AddTabButtonClick" SelectionChanged="DocumentTabs_SelectionChanged" TabCloseRequested="DocumentTabs_TabCloseRequested" CanDragTabs="False" CanReorderTabs="True" />
        <Grid Grid.Row="1" x:Name="ViewportFrame">
          <Grid.RowDefinitions><RowDefinition x:Name="RulerRow" Height="22" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="RulerColumn" Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Background="{ThemeResource StudioHeader}"><TextBlock Text="px" FontSize="9" Foreground="{ThemeResource StudioMuted}" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border>
          <local:StudioRuler x:Name="HorizontalRuler" Grid.Column="1" Orientation="Horizontal" />
          <local:StudioRuler x:Name="VerticalRuler" Grid.Row="1" Orientation="Vertical" />
          <local:SvgEditorCanvas x:Name="Canvas" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>
        <local:StudioSplitter x:Name="BottomDockSplitter" Grid.Row="2" />
        <local:StudioDockGroup x:Name="BottomDock" Grid.Row="3" />
      </Grid>
      <Border Grid.Column="4" Background="{ThemeResource StudioHeader}" BorderBrush="{ThemeResource StudioDivider}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PanelRail" Spacing="3" Margin="2,5" /></ScrollViewer>
      </Border>
      <local:StudioSplitter x:Name="RightDockSplitter" Grid.Column="5" />
      <Grid x:Name="RightDockContainer" Grid.Column="6">
        <Grid.RowDefinitions><RowDefinition x:Name="RightTopRow" Height="3*" /><RowDefinition Height="6" /><RowDefinition x:Name="RightBottomRow" Height="2*" /></Grid.RowDefinitions>
        <local:StudioDockGroup x:Name="RightTopDock" />
        <local:StudioSplitter x:Name="RightGroupSplitter" Grid.Row="1" />
        <local:StudioDockGroup x:Name="RightBottomDock" Grid.Row="2" />
      </Grid>
    </Grid>
    <Border Grid.Row="3" Background="{ThemeResource StudioHeader}" BorderBrush="{ThemeResource StudioDivider}" BorderThickness="0,1,0,0">
      <Grid Padding="6,0" ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <local:StudioIconButton Tag="zoomout" Click="Command_Click" Label="Zoom out" Content="−" />
          <Button x:Name="ZoomLabel" Tag="zoom100" Click="Command_Click" Content="100%" Style="{StaticResource CompactButton}" MinWidth="62" />
          <local:StudioIconButton Tag="zoomin" Click="Command_Click" Label="Zoom in" Content="+" />
          <local:StudioIconButton Tag="fit" Click="Command_Click" Label="Fit artboard" Content="Fit" />
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="StatusText" Text="Ready" FontSize="11" Foreground="{ThemeResource StudioMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" x:Name="PositionText" FontSize="10" Foreground="{ThemeResource StudioMuted}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <ToggleButton x:Name="SnapToggle" Content="Snap" Click="SnapToggle_Click" MinHeight="24" Padding="6,1" FontSize="11" ToolTipService.ToolTip="Snap geometry to the document grid" />
          <local:StudioIconButton Tag="grid" Click="Command_Click" Label="Toggle grid" Content="Grid" MinHeight="24" />
          <TextBlock x:Name="WorkspaceLabel" Text="SVG · Direct canvas" FontSize="10" Foreground="{ThemeResource StudioMuted}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
    <!-- Live views are attached to retained panel groups, never copied into popups. -->
    <Grid x:Name="PanelStaging" Visibility="Collapsed">
      <Border x:Name="OutlinePanel">
        <Grid RowSpacing="8" Padding="{StaticResource StudioPanelPadding}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBox x:Name="OutlineSearch" PlaceholderText="Search layers and objects" TextChanged="OutlineSearch_TextChanged" />
          <TreeView Grid.Row="1" x:Name="DocumentOutline" SelectionMode="Single" ItemInvoked="DocumentOutline_ItemInvoked"
                    ItemTemplate="{StaticResource StudioOutlineRowTemplate}" ItemContainerStyle="{StaticResource StudioOutlineContainer}"
                    CanDragItems="False" CanReorderItems="False" />
          <local:StudioWrapPanel Grid.Row="2" Spacing="4">
            <Button Style="{StaticResource CompactButton}" Tag="layer" Click="Command_Click" Content="＋ Layer" />
            <Button Style="{StaticResource CompactButton}" Tag="group" Click="Command_Click" Content="Group" />
            <Button Style="{StaticResource CompactButton}" Tag="lock" Click="Command_Click" Content="Lock" />
            <Button Style="{StaticResource CompactButton}" Tag="hide" Click="Command_Click" Content="Hide" />
            <Button Style="{StaticResource StudioDangerButtonStyle}" MinHeight="28" Padding="8,3" Tag="delete" Click="Command_Click" Content="Delete" />
          </local:StudioWrapPanel>
        </Grid>
      </Border>
      <Border x:Name="InspectorPanel">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="{StaticResource StudioPanelPadding}" Spacing="8">
            <TextBlock x:Name="SelectionBadge" Text="Artboard" FontSize="11" Foreground="{ThemeResource StudioMuted}" />
            <TextBlock x:Name="SelectionName" Text="Artboard" FontSize="{StaticResource StudioTitleSize}" Foreground="{ThemeResource StudioForeground}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <StackPanel x:Name="InspectorContent" Spacing="8" />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border x:Name="AttributesPanel">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="{StaticResource StudioPanelPadding}" Spacing="8">
          <TextBox x:Name="AttributeSearch" PlaceholderText="Search SVG attributes" TextChanged="AttributeSearch_TextChanged" />
          <StackPanel x:Name="AttributeFields" Spacing="12" />
          <Button Tag="source" Click="Command_Click" Content="Edit SVG source…" HorizontalAlignment="Stretch" Style="{StaticResource CompactButton}" />
        </StackPanel></ScrollViewer>
      </Border>
      <Border x:Name="ResourcesPanel">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="{StaticResource StudioPanelPadding}" Spacing="8">
          <TextBlock Text="Document paints and symbols" Style="{StaticResource SectionLabel}" />
          <ComboBox x:Name="ResourceList" HorizontalAlignment="Stretch" PlaceholderText="Choose a resource" SelectionChanged="ResourceList_SelectionChanged" />
          <StackPanel x:Name="ResourcesShelf" Spacing="8" />
        </StackPanel></ScrollViewer>
      </Border>
    </Grid>
    <Canvas x:Name="FloatingPanelLayer" Grid.Row="2" />
  </Grid>
</UserControl>
