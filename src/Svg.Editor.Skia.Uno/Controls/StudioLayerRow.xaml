<UserControl x:Class="Svg.Editor.Skia.Uno.StudioLayerRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Svg.Editor.Skia.Uno"
             IsTabStop="False" MinWidth="0" HorizontalAlignment="Stretch">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><local:StudioThemeResources /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <Grid MinHeight="30" ColumnSpacing="4" Background="Transparent">
    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="24" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Button x:Name="VisibilityButton" Click="Visibility_Click" Style="{StaticResource StudioQuietButtonStyle}" MinWidth="24" MinHeight="24" Padding="2" VerticalAlignment="Center">
      <Grid Width="18" Height="18">
        <Path Data="M1,9 C5,2 13,2 17,9 C13,16 5,16 1,9 Z M11,9 A2,2 0 1 1 7,9 A2,2 0 1 1 11,9" Stroke="{ThemeResource StudioMuted}" StrokeThickness="1.2" />
        <Line x:Name="HiddenMark" X1="2" Y1="16" X2="16" Y2="2" Stroke="{ThemeResource StudioForeground}" StrokeThickness="1.6" Visibility="Collapsed" />
      </Grid>
    </Button>
    <Button x:Name="LockButton" Grid.Column="1" Click="Lock_Click" Style="{StaticResource StudioQuietButtonStyle}" MinWidth="24" MinHeight="24" Padding="2" VerticalAlignment="Center">
      <Grid Width="18" Height="20">
        <Path Data="M5,8 V5 C5,0 13,0 13,5 V8 M3,8 H15 V18 H3 Z M9,11 V15" Stroke="{ThemeResource StudioMuted}" StrokeThickness="1.2" />
      </Grid>
    </Button>
    <Border Grid.Column="2" Background="{ThemeResource StudioRaised}" BorderBrush="{ThemeResource StudioDivider}" BorderThickness="1" CornerRadius="3" Margin="0,5">
      <TextBlock x:Name="KindText" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource StudioMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <TextBlock x:Name="TitleText" Grid.Column="3" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" DoubleTapped="Title_DoubleTapped" />
  </Grid>
</UserControl>
