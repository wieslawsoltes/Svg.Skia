<ResourceDictionary x:Class="Svg.Editor.Skia.Uno.StudioPaletteResources"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- One semantic palette for the workspace, native controls, popups and custom templates. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="StudioCanvasColor">#BABABA</Color>
      <Color x:Key="StudioSurfaceColor">#F0F0F0</Color>
      <Color x:Key="StudioHeaderColor">#DEDEDE</Color>
      <Color x:Key="StudioRaisedColor">#FFFFFF</Color>
      <Color x:Key="StudioInputColor">#FFFFFF</Color>
      <Color x:Key="StudioBorderColor">#A6A6A6</Color>
      <Color x:Key="StudioDividerColor">#C4C4C4</Color>
      <Color x:Key="StudioForegroundColor">#242424</Color>
      <Color x:Key="StudioMutedColor">#595959</Color>
      <Color x:Key="StudioDisabledColor">#808080</Color>
      <Color x:Key="StudioHoverColor">#D8D8D8</Color>
      <Color x:Key="StudioHoverForegroundColor">#242424</Color>
      <Color x:Key="StudioSelectionColor">#C7DDF4</Color>
      <Color x:Key="StudioSelectionForegroundColor">#153D6B</Color>
      <Color x:Key="StudioAccentColor">#2862B0</Color>
      <Color x:Key="StudioOnAccentColor">#FFFFFF</Color>
      <Color x:Key="StudioDangerColor">#AF2637</Color>
      <Color x:Key="StudioCanvasLabelColor">#464646</Color>
      <Color x:Key="StudioCanvasOutlineColor">#5A808080</Color>
      <Color x:Key="StudioCanvasShadowColor">#06000000</Color>
      <Color x:Key="StudioCanvasAccentColor">#3F6FF2</Color>
      <Color x:Key="StudioCanvasHandleColor">#FFFFFF</Color>
      <Color x:Key="StudioCanvasGridColor">#36969696</Color>
      <Color x:Key="StudioGuideColor">#3ECFDA</Color>
      <Color x:Key="StudioGuidePreviewColor">#F281DC</Color>
      <Color x:Key="StudioSmartGuideColor">#D755CD</Color>
      <Color x:Key="StudioCanvasCheckerBackgroundColor">#FFFFFF</Color>
      <Color x:Key="StudioCanvasCheckerForegroundColor">#EFF1F5</Color>
      <Color x:Key="StudioRulerForegroundColor">#505050</Color>
      <Color x:Key="StudioRulerPointerColor">#366ACC</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="StudioCanvasColor">#1E1E1E</Color>
      <Color x:Key="StudioSurfaceColor">#323232</Color>
      <Color x:Key="StudioHeaderColor">#292929</Color>
      <Color x:Key="StudioRaisedColor">#3C3C3C</Color>
      <Color x:Key="StudioInputColor">#242424</Color>
      <Color x:Key="StudioBorderColor">#5D5D5D</Color>
      <Color x:Key="StudioDividerColor">#222222</Color>
      <Color x:Key="StudioForegroundColor">#ECECEC</Color>
      <Color x:Key="StudioMutedColor">#B8B8B8</Color>
      <Color x:Key="StudioDisabledColor">#858585</Color>
      <Color x:Key="StudioHoverColor">#454545</Color>
      <Color x:Key="StudioHoverForegroundColor">#ECECEC</Color>
      <Color x:Key="StudioSelectionColor">#464646</Color>
      <Color x:Key="StudioSelectionForegroundColor">#FFFFFF</Color>
      <Color x:Key="StudioAccentColor">#94BFF2</Color>
      <Color x:Key="StudioOnAccentColor">#182738</Color>
      <Color x:Key="StudioDangerColor">#FFA7B4</Color>
      <Color x:Key="StudioCanvasLabelColor">#B8B8B8</Color>
      <Color x:Key="StudioCanvasOutlineColor">#5A808080</Color>
      <Color x:Key="StudioCanvasShadowColor">#0A000000</Color>
      <Color x:Key="StudioCanvasAccentColor">#3F6FF2</Color>
      <Color x:Key="StudioCanvasHandleColor">#FFFFFF</Color>
      <Color x:Key="StudioCanvasGridColor">#36969696</Color>
      <Color x:Key="StudioGuideColor">#3ECFDA</Color>
      <Color x:Key="StudioGuidePreviewColor">#F281DC</Color>
      <Color x:Key="StudioSmartGuideColor">#D755CD</Color>
      <Color x:Key="StudioCanvasCheckerBackgroundColor">#FFFFFF</Color>
      <Color x:Key="StudioCanvasCheckerForegroundColor">#EFF1F5</Color>
      <Color x:Key="StudioRulerForegroundColor">#B8B8B8</Color>
      <Color x:Key="StudioRulerPointerColor">#83B0FF</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <StaticResource x:Key="StudioCanvasColor" ResourceKey="SystemColorWindowColor" />
      <StaticResource x:Key="StudioSurfaceColor" ResourceKey="SystemColorWindowColor" />
      <StaticResource x:Key="StudioHeaderColor" ResourceKey="SystemColorWindowColor" />
      <StaticResource x:Key="StudioRaisedColor" ResourceKey="SystemColorWindowColor" />
      <StaticResource x:Key="StudioInputColor" ResourceKey="SystemColorWindowColor" />
      <StaticResource x:Key="StudioBorderColor" ResourceKey="SystemColorWindowTextColor" />
      <StaticResource x:Key="StudioDividerColor" ResourceKey="SystemColorWindowTextColor" />
      <StaticResource x:Key="StudioForegroundColor" ResourceKey="SystemColorWindowTextColor" />
      <StaticResource x:Key="StudioMutedColor" ResourceKey="SystemColorWindowTextColor" />
      <StaticResource x:Key="StudioDisabledColor" ResourceKey="SystemColorGrayTextColor" />
      <StaticResource x:Key="StudioHoverColor" ResourceKey="SystemColorHighlightColor" />
      <StaticResource x:Key="StudioHoverForegroundColor" ResourceKey="SystemColorHighlightTextColor" />
      <StaticResource x:Key="StudioSelectionColor" ResourceKey="SystemColorHighlightColor" />
      <StaticResource x:Key="StudioSelectionForegroundColor" ResourceKey="SystemColorHighlightTextColor" />
      <StaticResource x:Key="StudioAccentColor" ResourceKey="SystemColorHighlightColor" />
      <StaticResource x:Key="StudioOnAccentColor" ResourceKey="SystemColorHighlightTextColor" />
      <StaticResource x:Key="StudioDangerColor" ResourceKey="SystemColorWindowTextColor" />
      <StaticResource x:Key="StudioCanvasLabelColor" ResourceKey="SystemColorWindowTextColor" />
      <StaticResource x:Key="StudioCanvasOutlineColor" ResourceKey="SystemColorWindowTextColor" />
      <!-- Decorative shadows disappear in system high contrast. -->
      <Color x:Key="StudioCanvasShadowColor">#00000000</Color>
      <StaticResource x:Key="StudioCanvasAccentColor" ResourceKey="SystemColorHighlightColor" />
      <StaticResource x:Key="StudioCanvasHandleColor" ResourceKey="SystemColorWindowColor" />
      <StaticResource x:Key="StudioCanvasGridColor" ResourceKey="SystemColorGrayTextColor" />
      <StaticResource x:Key="StudioGuideColor" ResourceKey="SystemColorWindowTextColor" />
      <StaticResource x:Key="StudioGuidePreviewColor" ResourceKey="SystemColorHighlightColor" />
      <StaticResource x:Key="StudioSmartGuideColor" ResourceKey="SystemColorHighlightColor" />
      <StaticResource x:Key="StudioCanvasCheckerBackgroundColor" ResourceKey="SystemColorWindowColor" />
      <StaticResource x:Key="StudioCanvasCheckerForegroundColor" ResourceKey="SystemColorGrayTextColor" />
      <StaticResource x:Key="StudioRulerForegroundColor" ResourceKey="SystemColorWindowTextColor" />
      <StaticResource x:Key="StudioRulerPointerColor" ResourceKey="SystemColorHighlightColor" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <SolidColorBrush x:Key="StudioCanvas" Color="{ThemeResource StudioCanvasColor}" />
  <SolidColorBrush x:Key="StudioSurface" Color="{ThemeResource StudioSurfaceColor}" />
  <SolidColorBrush x:Key="StudioHeader" Color="{ThemeResource StudioHeaderColor}" />
  <SolidColorBrush x:Key="StudioRaised" Color="{ThemeResource StudioRaisedColor}" />
  <SolidColorBrush x:Key="StudioInputBackground" Color="{ThemeResource StudioInputColor}" />
  <SolidColorBrush x:Key="StudioBorder" Color="{ThemeResource StudioBorderColor}" />
  <SolidColorBrush x:Key="StudioDivider" Color="{ThemeResource StudioDividerColor}" />
  <SolidColorBrush x:Key="StudioForeground" Color="{ThemeResource StudioForegroundColor}" />
  <SolidColorBrush x:Key="StudioMuted" Color="{ThemeResource StudioMutedColor}" />
  <SolidColorBrush x:Key="StudioDisabled" Color="{ThemeResource StudioDisabledColor}" />
  <SolidColorBrush x:Key="StudioHover" Color="{ThemeResource StudioHoverColor}" />
  <SolidColorBrush x:Key="StudioHoverForeground" Color="{ThemeResource StudioHoverForegroundColor}" />
  <SolidColorBrush x:Key="StudioSelection" Color="{ThemeResource StudioSelectionColor}" />
  <SolidColorBrush x:Key="StudioSelectionForeground" Color="{ThemeResource StudioSelectionForegroundColor}" />
  <SolidColorBrush x:Key="StudioAccent" Color="{ThemeResource StudioAccentColor}" />
  <SolidColorBrush x:Key="StudioOnAccent" Color="{ThemeResource StudioOnAccentColor}" />
  <SolidColorBrush x:Key="StudioDanger" Color="{ThemeResource StudioDangerColor}" />
  <SolidColorBrush x:Key="StudioCanvasLabel" Color="{ThemeResource StudioCanvasLabelColor}" />
  <SolidColorBrush x:Key="StudioCanvasOutline" Color="{ThemeResource StudioCanvasOutlineColor}" />
  <SolidColorBrush x:Key="StudioCanvasShadow" Color="{ThemeResource StudioCanvasShadowColor}" />
  <SolidColorBrush x:Key="StudioCanvasAccent" Color="{ThemeResource StudioCanvasAccentColor}" />
  <SolidColorBrush x:Key="StudioCanvasHandle" Color="{ThemeResource StudioCanvasHandleColor}" />
  <SolidColorBrush x:Key="StudioCanvasGrid" Color="{ThemeResource StudioCanvasGridColor}" />
  <SolidColorBrush x:Key="StudioGuide" Color="{ThemeResource StudioGuideColor}" />
  <SolidColorBrush x:Key="StudioGuidePreview" Color="{ThemeResource StudioGuidePreviewColor}" />
  <SolidColorBrush x:Key="StudioSmartGuide" Color="{ThemeResource StudioSmartGuideColor}" />
  <SolidColorBrush x:Key="StudioCanvasCheckerBackground" Color="{ThemeResource StudioCanvasCheckerBackgroundColor}" />
  <SolidColorBrush x:Key="StudioCanvasCheckerForeground" Color="{ThemeResource StudioCanvasCheckerForegroundColor}" />
  <SolidColorBrush x:Key="StudioRulerForeground" Color="{ThemeResource StudioRulerForegroundColor}" />
  <SolidColorBrush x:Key="StudioRulerPointer" Color="{ThemeResource StudioRulerPointerColor}" />
  <!-- Compatibility names are aliases to the same colors, not independent palettes. -->
  <SolidColorBrush x:Key="WorkspaceBackground" Color="{ThemeResource StudioCanvasColor}" />
  <SolidColorBrush x:Key="PanelBackground" Color="{ThemeResource StudioSurfaceColor}" />
  <SolidColorBrush x:Key="PanelBorder" Color="{ThemeResource StudioDividerColor}" />
  <SolidColorBrush x:Key="MutedForeground" Color="{ThemeResource StudioMutedColor}" />
  <SolidColorBrush x:Key="SoftAccent" Color="{ThemeResource StudioSelectionColor}" />
  <SolidColorBrush x:Key="AccentForeground" Color="{ThemeResource StudioAccentColor}" />
  <x:Double x:Key="StudioBodySize">12</x:Double>
  <x:Double x:Key="StudioLabelSize">11</x:Double>
  <x:Double x:Key="StudioTitleSize">14</x:Double>
  <x:Double x:Key="StudioControlHeight">28</x:Double>
  <x:Double x:Key="StudioCompactHeight">24</x:Double>
  <!-- 28px target + 4px margins + 1px border needs 33px. The Auto column adds
       the visible 12px scrollbar, providing at least 45px without shrinking targets. -->
  <x:Double x:Key="StudioPanelRailMinWidth">34</x:Double>
  <x:Double x:Key="StudioGap">8</x:Double>
  <x:Double x:Key="StudioSectionGap">12</x:Double>
  <Thickness x:Key="StudioPanelPadding">10</Thickness>
  <Thickness x:Key="StudioControlPadding">8,4</Thickness>
  <Thickness x:Key="StudioCompactPadding">8,3</Thickness>
  <CornerRadius x:Key="StudioControlRadius">2</CornerRadius>
  <CornerRadius x:Key="StudioSurfaceRadius">2</CornerRadius>
  <Thickness x:Key="StudioControlBorder">1</Thickness>
</ResourceDictionary>
