<ResourceDictionary x:Class="Svg.Editor.Skia.Uno.EditorColorTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
                    xmlns:local="using:Svg.Editor.Skia.Uno">
  <ResourceDictionary.MergedDictionaries>
    <local:StudioPaletteResources />
    <local:EditorInputTemplates />
    <local:EditorRangeTemplates />
  </ResourceDictionary.MergedDictionaries>
  <!-- The native color controls own gamut mapping, validation, keyboard input and automation. -->
  <ControlTemplate x:Key="EditorColorSpectrumTemplate" TargetType="primitives:ColorSpectrum">
    <Grid x:Name="LayoutRoot" Background="Transparent">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="RectangleBorder.Stroke" Value="{ThemeResource StudioAccent}" /><Setter Target="EllipseBorder.Stroke" Value="{ThemeResource StudioAccent}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed" />
          <VisualState x:Name="PressedLarge"><VisualState.Setters><Setter Target="SelectionEllipsePanel.Width" Value="36" /><Setter Target="SelectionEllipsePanel.Height" Value="36" /></VisualState.Setters></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="SelectionEllipseColor">
          <VisualState x:Name="SelectionEllipseLight" />
          <VisualState x:Name="SelectionEllipseDark"><VisualState.Setters><Setter Target="FocusEllipse.Stroke" Value="White" /><Setter Target="SelectionEllipse.Stroke" Value="Black" /></VisualState.Setters></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="ShapeSelected">
          <VisualState x:Name="BoxSelected" />
          <VisualState x:Name="RingSelected"><VisualState.Setters>
            <Setter Target="SpectrumRectangle.Visibility" Value="Collapsed" /><Setter Target="SpectrumOverlayRectangle.Visibility" Value="Collapsed" /><Setter Target="RectangleBorder.Visibility" Value="Collapsed" />
            <Setter Target="SpectrumEllipse.Visibility" Value="Visible" /><Setter Target="SpectrumOverlayEllipse.Visibility" Value="Visible" /><Setter Target="EllipseBorder.Visibility" Value="Visible" />
          </VisualState.Setters></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="FocusStates">
          <VisualState x:Name="Unfocused" /><VisualState x:Name="PointerFocused" />
          <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="FocusEllipse.Visibility" Value="Visible" /><Setter Target="RectangleBorder.Stroke" Value="{ThemeResource StudioAccent}" /><Setter Target="EllipseBorder.Stroke" Value="{ThemeResource StudioAccent}" /></VisualState.Setters></VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Grid x:Name="SizingGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.Clip><RectangleGeometry /></Grid.Clip>
        <Rectangle x:Name="SpectrumRectangle" IsHitTestVisible="False" />
        <Rectangle x:Name="SpectrumOverlayRectangle" IsHitTestVisible="False" />
        <Ellipse x:Name="SpectrumEllipse" IsHitTestVisible="False" Visibility="Collapsed" />
        <Ellipse x:Name="SpectrumOverlayEllipse" IsHitTestVisible="False" Visibility="Collapsed" />
        <Canvas x:Name="InputTarget" Background="Transparent" Control.IsTemplateFocusTarget="True">
          <Grid x:Name="SelectionEllipsePanel" Width="12" Height="12">
            <Ellipse x:Name="FocusEllipse" Stroke="Black" StrokeThickness="2" Margin="-2" IsHitTestVisible="False" Visibility="Collapsed" />
            <Ellipse x:Name="SelectionEllipse" Stroke="White" StrokeThickness="2" IsHitTestVisible="False">
              <ToolTipService.ToolTip><ToolTip x:Name="ColorNameToolTip" VerticalOffset="18" /></ToolTipService.ToolTip>
            </Ellipse>
          </Grid>
        </Canvas>
        <Rectangle x:Name="RectangleBorder" Stroke="{ThemeResource StudioBorder}" StrokeThickness="1" IsHitTestVisible="False" />
        <Ellipse x:Name="EllipseBorder" Stroke="{ThemeResource StudioBorder}" StrokeThickness="1" IsHitTestVisible="False" Visibility="Collapsed" />
      </Grid>
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="EditorColorSliderThumbTemplate" TargetType="Thumb">
    <Grid Background="Transparent">
      <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
        <VisualState x:Name="Normal" />
        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Outline.Stroke" Value="{ThemeResource StudioAccent}" /></VisualState.Setters></VisualState>
        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Outline.Stroke" Value="{ThemeResource StudioAccent}" /><Setter Target="Grip.Fill" Value="{ThemeResource StudioSelection}" /></VisualState.Setters></VisualState>
        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Outline.Opacity" Value="0.5" /></VisualState.Setters></VisualState>
      </VisualStateGroup></VisualStateManager.VisualStateGroups>
      <Rectangle x:Name="Grip" Fill="{ThemeResource StudioRaised}" Stroke="Black" StrokeThickness="3" Margin="1" />
      <Rectangle x:Name="Outline" Stroke="White" StrokeThickness="1" Margin="1" />
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="EditorColorPickerSliderTemplate" TargetType="primitives:ColorPickerSlider">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" /><VisualState x:Name="PointerOver" /><VisualState x:Name="Pressed" />
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="SliderContainer.Opacity" Value="0.5" /></VisualState.Setters></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Unfocused" /><VisualState x:Name="Focused"><VisualState.Setters><Setter Target="FocusBorder.Opacity" Value="1" /></VisualState.Setters></VisualState></VisualStateGroup>
        <VisualStateGroup x:Name="FocusEngagementStates">
          <VisualState x:Name="FocusDisengaged" />
          <VisualState x:Name="FocusEngagedHorizontal"><VisualState.Setters><Setter Target="SliderContainer.(Control.IsTemplateFocusTarget)" Value="False" /><Setter Target="HorizontalThumb.(Control.IsTemplateFocusTarget)" Value="True" /></VisualState.Setters></VisualState>
          <VisualState x:Name="FocusEngagedVertical"><VisualState.Setters><Setter Target="SliderContainer.(Control.IsTemplateFocusTarget)" Value="False" /><Setter Target="VerticalThumb.(Control.IsTemplateFocusTarget)" Value="True" /></VisualState.Setters></VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <ContentPresenter x:Name="HeaderContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{ThemeResource StudioMuted}" Visibility="Collapsed" />
      <Grid x:Name="SliderContainer" Grid.Row="1" Background="Transparent" Control.IsTemplateFocusTarget="True">
        <Grid x:Name="HorizontalTemplate" MinHeight="24">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Rectangle x:Name="HorizontalTrackRect" Grid.Row="1" Grid.ColumnSpan="3" Height="12" Fill="Transparent" />
          <Rectangle x:Name="HorizontalDecreaseRect" Grid.Row="1" Height="12" Fill="Transparent" />
          <Thumb x:Name="HorizontalThumb" Grid.Column="1" Grid.RowSpan="3" Width="8" Height="20" Template="{StaticResource EditorColorSliderThumbTemplate}" DataContext="{TemplateBinding Value}" IsTabStop="False" AutomationProperties.AccessibilityView="Raw">
            <ToolTipService.ToolTip><ToolTip x:Name="ToolTip" VerticalOffset="18" /></ToolTipService.ToolTip>
          </Thumb>
        </Grid>
        <Grid x:Name="VerticalTemplate" MinWidth="24" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Rectangle x:Name="VerticalTrackRect" Grid.Column="1" Grid.RowSpan="3" Width="12" Fill="Transparent" />
          <Rectangle x:Name="VerticalDecreaseRect" Grid.Column="1" Grid.Row="2" Width="12" Fill="Transparent" />
          <Thumb x:Name="VerticalThumb" Grid.Row="1" Grid.ColumnSpan="3" Width="20" Height="8" Template="{StaticResource EditorColorSliderThumbTemplate}" DataContext="{TemplateBinding Value}" IsTabStop="False" AutomationProperties.AccessibilityView="Raw">
            <ToolTipService.ToolTip><ToolTip x:Name="VerticalToolTip" VerticalOffset="18" /></ToolTipService.ToolTip>
          </Thumb>
        </Grid>
      </Grid>
      <Border x:Name="FocusBorder" Grid.Row="1" BorderBrush="{ThemeResource StudioAccent}" BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="EditorColorPickerTemplate" TargetType="ColorPicker">
    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" MinWidth="180" MaxWidth="340">
      <Grid.Resources><SolidColorBrush x:Name="CheckerColorBrush" Color="{ThemeResource StudioBorderColor}" /></Grid.Resources>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="ColorSpectrumVisibility">
          <VisualState x:Name="ColorSpectrumVisible" />
          <VisualState x:Name="ColorSpectrumCollapsed"><VisualState.Setters>
            <Setter Target="ColorSpectrum.Visibility" Value="Collapsed" />
            <Setter Target="ColorPreviewRectangleGrid.Width" Value="NaN" />
            <Setter Target="ColorPreviewRectangleGrid.Height" Value="28" />
            <Setter Target="ColorPreviewRectangleGrid.Margin" Value="0" />
            <Setter Target="ColorPreviewRectangleGrid.(Grid.Column)" Value="0" />
            <Setter Target="ColorPreviewRectangleGrid.(Grid.ColumnSpan)" Value="2" />
          </VisualState.Setters></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="ColorPreviewVisibility">
          <VisualState x:Name="ColorPreviewVisible" />
          <VisualState x:Name="ColorPreviewCollapsed"><VisualState.Setters>
            <Setter Target="ColorPreviewRectangleGrid.Visibility" Value="Collapsed" />
          </VisualState.Setters></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="PreviousColorVisibility">
          <VisualState x:Name="PreviousColorCollapsedVertical" />
          <VisualState x:Name="PreviousColorVisibleVertical"><VisualState.Setters>
            <Setter Target="ColorPreviewRectangle.(Grid.RowSpan)" Value="1" />
            <Setter Target="PreviousColorRectangle.Visibility" Value="Visible" />
          </VisualState.Setters></VisualState>
          <VisualState x:Name="PreviousColorCollapsedHorizontal"><VisualState.Setters>
            <Setter Target="PreviousColorRectangle.(Grid.Row)" Value="0" />
            <Setter Target="PreviousColorRectangle.(Grid.Column)" Value="1" />
            <Setter Target="PreviousColorRectangle.(Grid.RowSpan)" Value="2" />
            <Setter Target="PreviousColorRectangle.(Grid.ColumnSpan)" Value="1" />
          </VisualState.Setters></VisualState>
          <VisualState x:Name="PreviousColorVisibleHorizontal"><VisualState.Setters>
            <Setter Target="ColorPreviewRectangle.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="PreviousColorRectangle.Visibility" Value="Visible" />
            <Setter Target="PreviousColorRectangle.(Grid.Row)" Value="0" />
            <Setter Target="PreviousColorRectangle.(Grid.Column)" Value="1" />
            <Setter Target="PreviousColorRectangle.(Grid.RowSpan)" Value="2" />
            <Setter Target="PreviousColorRectangle.(Grid.ColumnSpan)" Value="1" />
          </VisualState.Setters></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="ThirdDimensionSliderVisibility">
          <VisualState x:Name="ThirdDimensionSliderVisible" />
          <VisualState x:Name="ThirdDimensionSliderCollapsed"><VisualState.Setters>
            <Setter Target="ThirdDimensionSliderGrid.Visibility" Value="Collapsed" />
          </VisualState.Setters></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="AlphaSliderVisibility">
          <VisualState x:Name="AlphaSliderVisible" />
          <VisualState x:Name="AlphaSliderCollapsed"><VisualState.Setters>
            <Setter Target="AlphaSliderGrid.Visibility" Value="Collapsed" />
          </VisualState.Setters></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="MoreButtonVisibility">
          <VisualState x:Name="MoreButtonVisible" />
          <VisualState x:Name="MoreButtonCollapsed"><VisualState.Setters>
            <Setter Target="MoreButton.Visibility" Value="Collapsed" />
          </VisualState.Setters></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="AlphaTextInputVisibility">
          <VisualState x:Name="AlphaTextInputVisible" />
          <VisualState x:Name="AlphaTextInputCollapsed"><VisualState.Setters>
            <Setter Target="AlphaPanel.Visibility" Value="Collapsed" />
            <Setter Target="HexPanel.(Grid.Column)" Value="0" />
            <Setter Target="HexPanel.(Grid.ColumnSpan)" Value="2" />
          </VisualState.Setters></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="HexInputVisibility">
          <VisualState x:Name="HexInputVisible" />
          <VisualState x:Name="HexInputCollapsed"><VisualState.Setters>
            <Setter Target="HexPanel.Visibility" Value="Collapsed" />
          </VisualState.Setters></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="TextEntryGridVisibility">
          <VisualState x:Name="TextEntryGridCollapsed" />
          <VisualState x:Name="TextEntryGridVisible"><VisualState.Setters>
            <Setter Target="TextEntryGrid.Visibility" Value="Visible" />
            <Setter Target="MoreGlyph.Text" Value="⌃" />
          </VisualState.Setters></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="ColorChannelTextInputVisibility">
          <VisualState x:Name="ColorChannelTextInputVisible" />
          <VisualState x:Name="ColorChannelTextInputCollapsed"><VisualState.Setters>
            <Setter Target="ColorRepresentationComboBox.Visibility" Value="Collapsed" />
            <Setter Target="ColorChannelTextInputPanel.Visibility" Value="Collapsed" />
          </VisualState.Setters></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="ColorRepresentationSelected">
          <VisualState x:Name="RgbSelected" />
          <VisualState x:Name="HsvSelected"><VisualState.Setters>
            <Setter Target="RgbPanel.Visibility" Value="Collapsed" />
            <Setter Target="HsvPanel.Visibility" Value="Visible" />
          </VisualState.Setters></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="AlphaEnabledState">
          <VisualState x:Name="AlphaDisabled" />
          <VisualState x:Name="AlphaEnabled"><VisualState.Setters>
            <Setter Target="HexTextBox.MaxLength" Value="9" />
          </VisualState.Setters></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="Orientation">
          <VisualState x:Name="Vertical" />
          <VisualState x:Name="Horizontal"><VisualState.Setters>
            <Setter Target="RootGrid.MinWidth" Value="0" />
            <Setter Target="RootGrid.MaxWidth" Value="10000" />
            <Setter Target="RootGrid.MinHeight" Value="180" />
            <Setter Target="RootGrid.MaxHeight" Value="340" />
            <Setter Target="ColorSpectrumGrid.Margin" Value="0" />
            <Setter Target="ThirdDimensionSliderGrid.(Grid.Column)" Value="1" />
            <Setter Target="ThirdDimensionSliderGrid.(Grid.Row)" Value="0" />
            <Setter Target="ThirdDimensionSliderGrid.Margin" Value="6,0,0,0" />
            <Setter Target="ThirdDimensionSlider.Orientation" Value="Vertical" />
            <Setter Target="ThirdDimensionBackgroundRectangle.Height" Value="NaN" />
            <Setter Target="ThirdDimensionBackgroundRectangle.Width" Value="12" />
            <Setter Target="ThirdDimensionBackgroundRectangle.VerticalAlignment" Value="Stretch" />
            <Setter Target="ThirdDimensionBackgroundRectangle.HorizontalAlignment" Value="Center" />
            <Setter Target="ThirdDimensionRotation.Angle" Value="180" />
            <Setter Target="AlphaSliderGrid.(Grid.Column)" Value="2" />
            <Setter Target="AlphaSliderGrid.(Grid.Row)" Value="0" />
            <Setter Target="AlphaSliderGrid.Margin" Value="4,0,0,0" />
            <Setter Target="AlphaSlider.Orientation" Value="Vertical" />
            <Setter Target="AlphaSliderCheckeredBackgroundRectangle.Height" Value="NaN" />
            <Setter Target="AlphaSliderCheckeredBackgroundRectangle.Width" Value="12" />
            <Setter Target="AlphaSliderCheckeredBackgroundRectangle.VerticalAlignment" Value="Stretch" />
            <Setter Target="AlphaSliderCheckeredBackgroundRectangle.HorizontalAlignment" Value="Center" />
            <Setter Target="AlphaSliderBackgroundRectangle.Height" Value="NaN" />
            <Setter Target="AlphaSliderBackgroundRectangle.Width" Value="12" />
            <Setter Target="AlphaSliderBackgroundRectangle.VerticalAlignment" Value="Stretch" />
            <Setter Target="AlphaSliderBackgroundRectangle.HorizontalAlignment" Value="Center" />
            <Setter Target="AlphaRotation.Angle" Value="180" />
            <Setter Target="MoreEntriesPanel.(Grid.Column)" Value="3" />
            <Setter Target="MoreEntriesPanel.(Grid.Row)" Value="0" />
            <Setter Target="MoreEntriesPanel.Margin" Value="12,0,0,0" />
            <Setter Target="MoreEntriesPanel.MinWidth" Value="180" />
            <Setter Target="ColorPreviewRectangleGrid.Width" Value="28" />
          </VisualState.Setters></VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Grid x:Name="ColorSpectrumGrid" Margin="0,0,0,6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <primitives:ColorSpectrum x:Name="ColorSpectrum" Template="{StaticResource EditorColorSpectrumTemplate}" MinWidth="144" MinHeight="144" MaxWidth="300" MaxHeight="300" ManipulationMode="None" UseSystemFocusVisuals="False" MinHue="{TemplateBinding MinHue}" MaxHue="{TemplateBinding MaxHue}" MinSaturation="{TemplateBinding MinSaturation}" MaxSaturation="{TemplateBinding MaxSaturation}" MinValue="{TemplateBinding MinValue}" MaxValue="{TemplateBinding MaxValue}" Shape="{TemplateBinding ColorSpectrumShape}" Components="{TemplateBinding ColorSpectrumComponents}" TabIndex="0" />
        <Grid x:Name="ColorPreviewRectangleGrid" Grid.Column="1" Width="28" Margin="6,0,0,0">
          <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Rectangle Grid.RowSpan="2" Grid.ColumnSpan="2"><Rectangle.Fill><ImageBrush x:Name="ColorPreviewRectangleCheckeredBackgroundImageBrush" /></Rectangle.Fill></Rectangle>
          <Rectangle x:Name="ColorPreviewRectangle" Grid.RowSpan="2" Grid.ColumnSpan="2" />
          <Rectangle x:Name="PreviousColorRectangle" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" />
          <Rectangle Grid.RowSpan="2" Grid.ColumnSpan="2" Stroke="{ThemeResource StudioBorder}" StrokeThickness="1" IsHitTestVisible="False" />
        </Grid>
      </Grid>
      <Grid x:Name="ThirdDimensionSliderGrid" Grid.Row="1" Margin="0,0,0,2">
        <Rectangle x:Name="ThirdDimensionBackgroundRectangle" Height="12" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Stroke="{ThemeResource StudioBorder}" StrokeThickness="1">
          <Rectangle.Fill><LinearGradientBrush x:Name="ThirdDimensionSliderGradientBrush" /></Rectangle.Fill>
          <Rectangle.RenderTransform><RotateTransform x:Name="ThirdDimensionRotation" /></Rectangle.RenderTransform>
        </Rectangle>
        <primitives:ColorPickerSlider x:Name="ThirdDimensionSlider" Template="{StaticResource EditorColorPickerSliderTemplate}" Minimum="0" Maximum="100" ColorChannel="Value" IsThumbToolTipEnabled="False" UseSystemFocusVisuals="True" TabIndex="1" />
      </Grid>
      <Grid x:Name="AlphaSliderGrid" Grid.Row="2" Margin="0,0,0,6">
        <Rectangle x:Name="AlphaSliderCheckeredBackgroundRectangle" Height="12" VerticalAlignment="Center"><Rectangle.Fill><ImageBrush x:Name="AlphaSliderCheckeredBackgroundImageBrush" /></Rectangle.Fill></Rectangle>
        <Rectangle x:Name="AlphaSliderBackgroundRectangle" Height="12" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Stroke="{ThemeResource StudioBorder}" StrokeThickness="1">
          <Rectangle.Fill><LinearGradientBrush x:Name="AlphaSliderGradientBrush" /></Rectangle.Fill>
          <Rectangle.RenderTransform><RotateTransform x:Name="AlphaRotation" /></Rectangle.RenderTransform>
        </Rectangle>
        <primitives:ColorPickerSlider x:Name="AlphaSlider" Template="{StaticResource EditorColorPickerSliderTemplate}" Minimum="0" Maximum="100" ColorChannel="Alpha" IsThumbToolTipEnabled="False" UseSystemFocusVisuals="True" TabIndex="2" />
      </Grid>
      <StackPanel x:Name="MoreEntriesPanel" Grid.Row="3" Spacing="6">
        <ToggleButton x:Name="MoreButton" Template="{StaticResource EditorToggleButtonTemplate}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="6,3" MinHeight="24" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource StudioForeground}" TabIndex="3">
          <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock x:Name="MoreButtonLabel" FontSize="12" /><TextBlock x:Name="MoreGlyph" Text="⌄" FontSize="12" /></StackPanel>
        </ToggleButton>
        <StackPanel x:Name="TextEntryGrid" Spacing="6" Visibility="Collapsed">
          <ComboBox x:Name="ColorRepresentationComboBox" Template="{StaticResource EditorComboBoxTemplate}" SelectedIndex="0" HorizontalAlignment="Stretch" MinWidth="0" FontSize="12" Padding="6,3" MinHeight="24" TabIndex="4">
            <ComboBoxItem x:Name="RGBComboBoxItem" Content="RGB" /><ComboBoxItem x:Name="HSVComboBoxItem" Content="HSV" />
          </ComboBox>
          <Grid x:Name="ColorChannelTextInputPanel">
            <Grid x:Name="RgbPanel" ColumnSpacing="6" RowSpacing="4">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock x:Name="RedLabel" Grid.Column="0" Text="Red" FontSize="11" Foreground="{ThemeResource StudioMuted}" TextTrimming="CharacterEllipsis" />
              <TextBox x:Name="RedTextBox" Grid.Column="0" Grid.Row="1" Template="{StaticResource EditorTextBoxTemplate}" Text="255" MaxLength="3" InputScope="Number" TextAlignment="Right" MinWidth="0" MinHeight="24" Padding="6,3" FontSize="12" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" TabIndex="5" />
              <TextBlock x:Name="GreenLabel" Grid.Column="1" Text="Green" FontSize="11" Foreground="{ThemeResource StudioMuted}" TextTrimming="CharacterEllipsis" />
              <TextBox x:Name="GreenTextBox" Grid.Column="1" Grid.Row="1" Template="{StaticResource EditorTextBoxTemplate}" Text="255" MaxLength="3" InputScope="Number" TextAlignment="Right" MinWidth="0" MinHeight="24" Padding="6,3" FontSize="12" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" TabIndex="6" />
              <TextBlock x:Name="BlueLabel" Grid.Column="2" Text="Blue" FontSize="11" Foreground="{ThemeResource StudioMuted}" TextTrimming="CharacterEllipsis" />
              <TextBox x:Name="BlueTextBox" Grid.Column="2" Grid.Row="1" Template="{StaticResource EditorTextBoxTemplate}" Text="255" MaxLength="3" InputScope="Number" TextAlignment="Right" MinWidth="0" MinHeight="24" Padding="6,3" FontSize="12" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" TabIndex="7" />
            </Grid>
            <Grid x:Name="HsvPanel" Visibility="Collapsed" ColumnSpacing="6" RowSpacing="4">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock x:Name="HueLabel" Grid.Column="0" Text="Hue" FontSize="11" Foreground="{ThemeResource StudioMuted}" TextTrimming="CharacterEllipsis" />
              <TextBox x:Name="HueTextBox" Grid.Column="0" Grid.Row="1" Template="{StaticResource EditorTextBoxTemplate}" Text="0" MaxLength="3" InputScope="Number" TextAlignment="Right" MinWidth="0" MinHeight="24" Padding="6,3" FontSize="12" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" TabIndex="5" />
              <TextBlock x:Name="SaturationLabel" Grid.Column="1" Text="Saturation" FontSize="11" Foreground="{ThemeResource StudioMuted}" TextTrimming="CharacterEllipsis" />
              <TextBox x:Name="SaturationTextBox" Grid.Column="1" Grid.Row="1" Template="{StaticResource EditorTextBoxTemplate}" Text="0" MaxLength="3" InputScope="Number" TextAlignment="Right" MinWidth="0" MinHeight="24" Padding="6,3" FontSize="12" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" TabIndex="6" />
              <TextBlock x:Name="ValueLabel" Grid.Column="2" Text="Value" FontSize="11" Foreground="{ThemeResource StudioMuted}" TextTrimming="CharacterEllipsis" />
              <TextBox x:Name="ValueTextBox" Grid.Column="2" Grid.Row="1" Template="{StaticResource EditorTextBoxTemplate}" Text="100" MaxLength="3" InputScope="Number" TextAlignment="Right" MinWidth="0" MinHeight="24" Padding="6,3" FontSize="12" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" TabIndex="7" />
            </Grid>
          </Grid>
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.5*" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="AlphaPanel" Spacing="4">
              <TextBlock x:Name="AlphaLabel" Text="Alpha" FontSize="11" Foreground="{ThemeResource StudioMuted}" />
              <TextBox x:Name="AlphaTextBox" Template="{StaticResource EditorTextBoxTemplate}" Text="100%" MaxLength="4" InputScope="Number" TextAlignment="Right" MinWidth="0" MinHeight="24" Padding="6,3" FontSize="12" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" TabIndex="8" />
            </StackPanel>
            <StackPanel x:Name="HexPanel" Grid.Column="1" Spacing="4">
              <TextBlock Text="Hex" FontSize="11" Foreground="{ThemeResource StudioMuted}" />
              <TextBox x:Name="HexTextBox" Template="{StaticResource EditorTextBoxTemplate}" Text="#FFFFFF" MaxLength="7" MinWidth="0" MinHeight="24" Padding="6,3" FontSize="12" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" TabIndex="9" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </StackPanel>
    </Grid>
  </ControlTemplate>
</ResourceDictionary>
