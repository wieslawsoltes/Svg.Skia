<ResourceDictionary x:Class="Svg.Editor.Skia.Uno.EditorRangeTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Svg.Editor.Skia.Uno">
  <ResourceDictionary.MergedDictionaries><local:StudioPaletteResources /></ResourceDictionary.MergedDictionaries>
  <ControlTemplate x:Key="EditorScrollThumbTemplate" TargetType="Thumb">
    <Grid Background="Transparent">
      <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
        <VisualState x:Name="Normal" />
        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Grip.Background" Value="{ThemeResource StudioMuted}" /></VisualState.Setters></VisualState>
        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Grip.Background" Value="{ThemeResource StudioAccent}" /></VisualState.Setters></VisualState>
        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Grip.Background" Value="{ThemeResource StudioDivider}" /></VisualState.Setters></VisualState>
      </VisualStateGroup></VisualStateManager.VisualStateGroups>
      <Border x:Name="Grip" Background="{TemplateBinding Background}" Margin="2" CornerRadius="1" />
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="EditorScrollButtonTemplate" TargetType="RepeatButton">
    <Grid x:Name="Chrome" Background="Transparent">
      <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
        <VisualState x:Name="Normal" />
        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Chrome.Background" Value="{ThemeResource StudioHover}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioHoverForeground}" /></VisualState.Setters></VisualState>
        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Chrome.Background" Value="{ThemeResource StudioSelection}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioSelectionForeground}" /></VisualState.Setters></VisualState>
        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioDisabled}" /></VisualState.Setters></VisualState>
      </VisualStateGroup></VisualStateManager.VisualStateGroups>
      <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="EditorScrollBarTemplate" TargetType="ScrollBar">
    <Grid x:Name="Root" Background="{TemplateBinding Background}">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" /><VisualState x:Name="PointerOver" />
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.45" /></VisualState.Setters></VisualState>
        </VisualStateGroup>
        <!-- Editor scrollbars remain visible whenever requested by ScrollViewer. -->
        <VisualStateGroup x:Name="ScrollingIndicatorStates"><VisualState x:Name="NoIndicator" /><VisualState x:Name="MouseIndicator" /><VisualState x:Name="TouchIndicator" /></VisualStateGroup>
        <VisualStateGroup x:Name="ConsciousStates"><VisualState x:Name="Collapsed" /><VisualState x:Name="Expanded" /><VisualState x:Name="CollapsedWithoutAnimation" /><VisualState x:Name="ExpandedWithoutAnimation" /></VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Grid x:Name="HorizontalRoot" Visibility="Collapsed" Height="12" Background="{TemplateBinding Background}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /></Grid.ColumnDefinitions>
        <RepeatButton x:Name="HorizontalSmallDecrease" Template="{StaticResource EditorScrollButtonTemplate}" Content="‹" Foreground="{ThemeResource StudioMuted}" MinWidth="0" MinHeight="0" Padding="0" FontSize="12" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" />
        <RepeatButton x:Name="HorizontalLargeDecrease" Grid.Column="1" Template="{StaticResource EditorScrollButtonTemplate}" Width="0" MinWidth="0" MinHeight="0" Padding="0" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" />
        <Thumb x:Name="HorizontalThumb" Grid.Column="2" Template="{StaticResource EditorScrollThumbTemplate}" Background="{ThemeResource StudioBorder}" Height="12" MinWidth="20" IsTabStop="False" AutomationProperties.AccessibilityView="Raw" />
        <RepeatButton x:Name="HorizontalLargeIncrease" Grid.Column="3" Template="{StaticResource EditorScrollButtonTemplate}" MinWidth="0" MinHeight="0" Padding="0" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" />
        <RepeatButton x:Name="HorizontalSmallIncrease" Grid.Column="4" Template="{StaticResource EditorScrollButtonTemplate}" Content="›" Foreground="{ThemeResource StudioMuted}" MinWidth="0" MinHeight="0" Padding="0" FontSize="12" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" />
      </Grid>
      <Grid x:Name="VerticalRoot" Visibility="Collapsed" Width="12" Background="{TemplateBinding Background}">
        <Grid.RowDefinitions><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="12" /></Grid.RowDefinitions>
        <RepeatButton x:Name="VerticalSmallDecrease" Template="{StaticResource EditorScrollButtonTemplate}" Content="⌃" Foreground="{ThemeResource StudioMuted}" MinWidth="0" MinHeight="0" Padding="0" FontSize="9" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" />
        <RepeatButton x:Name="VerticalLargeDecrease" Grid.Row="1" Template="{StaticResource EditorScrollButtonTemplate}" Height="0" MinWidth="0" MinHeight="0" Padding="0" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" />
        <Thumb x:Name="VerticalThumb" Grid.Row="2" Template="{StaticResource EditorScrollThumbTemplate}" Background="{ThemeResource StudioBorder}" Width="12" MinHeight="20" IsTabStop="False" AutomationProperties.AccessibilityView="Raw" />
        <RepeatButton x:Name="VerticalLargeIncrease" Grid.Row="3" Template="{StaticResource EditorScrollButtonTemplate}" MinWidth="0" MinHeight="0" Padding="0" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" />
        <RepeatButton x:Name="VerticalSmallIncrease" Grid.Row="4" Template="{StaticResource EditorScrollButtonTemplate}" Content="⌄" Foreground="{ThemeResource StudioMuted}" MinWidth="0" MinHeight="0" Padding="0" FontSize="9" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" />
      </Grid>
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="EditorScrollViewerTemplate" TargetType="ScrollViewer">
    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
      <Grid Background="{TemplateBinding Background}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <ScrollContentPresenter x:Name="ScrollContentPresenter" Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}" />
        <ScrollBar x:Name="VerticalScrollBar" Grid.Column="1" Template="{StaticResource EditorScrollBarTemplate}" Width="12" Background="{ThemeResource StudioHeader}" IsTabStop="False" Maximum="{TemplateBinding ScrollableHeight}" Value="{TemplateBinding VerticalOffset}" ViewportSize="{TemplateBinding ViewportHeight}" Orientation="Vertical" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
        <ScrollBar x:Name="HorizontalScrollBar" Grid.Row="1" Template="{StaticResource EditorScrollBarTemplate}" Height="12" Background="{ThemeResource StudioHeader}" IsTabStop="False" Maximum="{TemplateBinding ScrollableWidth}" Value="{TemplateBinding HorizontalOffset}" ViewportSize="{TemplateBinding ViewportWidth}" Orientation="Horizontal" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
        <Border x:Name="ScrollBarSeparator" Grid.Row="1" Grid.Column="1" Background="{ThemeResource StudioHeader}" />
      </Grid>
    </Border>
  </ControlTemplate>
  <ControlTemplate x:Key="EditorSliderThumbTemplate" TargetType="Thumb">
    <Grid Background="Transparent">
      <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
        <VisualState x:Name="Normal" />
        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Grip.BorderBrush" Value="{ThemeResource StudioAccent}" /></VisualState.Setters></VisualState>
        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Grip.Background" Value="{ThemeResource StudioSelection}" /><Setter Target="Grip.BorderBrush" Value="{ThemeResource StudioAccent}" /></VisualState.Setters></VisualState>
        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Grip.Opacity" Value="0.5" /></VisualState.Setters></VisualState>
      </VisualStateGroup></VisualStateManager.VisualStateGroups>
      <Border x:Name="Grip" Background="{ThemeResource StudioRaised}" BorderBrush="{ThemeResource StudioMuted}" BorderThickness="1" CornerRadius="1" Margin="2" />
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="EditorSliderTemplate" TargetType="Slider">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" /><VisualState x:Name="PointerOver" /><VisualState x:Name="Pressed" />
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="SliderContainer.Opacity" Value="0.5" /><Setter Target="HeaderContentPresenter.Foreground" Value="{ThemeResource StudioDisabled}" /></VisualState.Setters></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Unfocused" /><VisualState x:Name="Focused"><VisualState.Setters><Setter Target="FocusBorder.Opacity" Value="1" /></VisualState.Setters></VisualState></VisualStateGroup>
        <VisualStateGroup x:Name="FocusEngagementStates"><VisualState x:Name="FocusDisengaged" /><VisualState x:Name="FocusEngagedHorizontal" /><VisualState x:Name="FocusEngagedVertical" /></VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <ContentPresenter x:Name="HeaderContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{ThemeResource StudioMuted}" Margin="0,0,0,5" TextWrapping="Wrap" Visibility="Collapsed" />
      <Grid x:Name="SliderContainer" Grid.Row="1" Background="Transparent">
        <Grid x:Name="HorizontalTemplate" MinHeight="26">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Rectangle x:Name="HorizontalTrackRect" Grid.Row="1" Grid.ColumnSpan="3" Height="4" Fill="{TemplateBinding Background}" />
          <Rectangle x:Name="HorizontalDecreaseRect" Grid.Row="1" Height="4" Fill="{TemplateBinding Foreground}" />
          <TickBar x:Name="TopTickBar" Grid.ColumnSpan="3" Height="3" Fill="{ThemeResource StudioMuted}" VerticalAlignment="Bottom" Margin="0,0,0,3" Visibility="Collapsed" />
          <TickBar x:Name="HorizontalInlineTickBar" Grid.Row="1" Grid.ColumnSpan="3" Height="4" Fill="{ThemeResource StudioMuted}" Visibility="Collapsed" />
          <TickBar x:Name="BottomTickBar" Grid.Row="2" Grid.ColumnSpan="3" Height="3" Fill="{ThemeResource StudioMuted}" VerticalAlignment="Top" Margin="0,3,0,0" Visibility="Collapsed" />
          <Thumb x:Name="HorizontalThumb" Grid.Column="1" Grid.RowSpan="3" Template="{StaticResource EditorSliderThumbTemplate}" Width="12" Height="20" DataContext="{TemplateBinding Value}" IsTabStop="False" AutomationProperties.AccessibilityView="Raw" />
        </Grid>
        <Grid x:Name="VerticalTemplate" MinWidth="26" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Rectangle x:Name="VerticalTrackRect" Grid.Column="1" Grid.RowSpan="3" Width="4" Fill="{TemplateBinding Background}" />
          <Rectangle x:Name="VerticalDecreaseRect" Grid.Column="1" Grid.Row="2" Width="4" Fill="{TemplateBinding Foreground}" />
          <TickBar x:Name="LeftTickBar" Grid.RowSpan="3" Width="3" Fill="{ThemeResource StudioMuted}" HorizontalAlignment="Right" Margin="0,0,3,0" Visibility="Collapsed" />
          <TickBar x:Name="VerticalInlineTickBar" Grid.Column="1" Grid.RowSpan="3" Width="4" Fill="{ThemeResource StudioMuted}" Visibility="Collapsed" />
          <TickBar x:Name="RightTickBar" Grid.Column="2" Grid.RowSpan="3" Width="3" Fill="{ThemeResource StudioMuted}" HorizontalAlignment="Left" Margin="3,0,0,0" Visibility="Collapsed" />
          <Thumb x:Name="VerticalThumb" Grid.Row="1" Grid.ColumnSpan="3" Template="{StaticResource EditorSliderThumbTemplate}" Width="20" Height="12" DataContext="{TemplateBinding Value}" IsTabStop="False" AutomationProperties.AccessibilityView="Raw" />
        </Grid>
      </Grid>
      <Border x:Name="FocusBorder" Grid.Row="1" BorderBrush="{ThemeResource StudioAccent}" BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="EditorProgressRingTemplate" TargetType="ProgressRing">
    <Grid x:Name="LayoutRoot" Background="Transparent">
      <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
        <VisualState x:Name="Inactive"><VisualState.Setters><Setter Target="LottiePlayer.Opacity" Value="0" /></VisualState.Setters></VisualState>
        <VisualState x:Name="Active" /><VisualState x:Name="DeterminateActive" />
      </VisualStateGroup></VisualStateManager.VisualStateGroups>
      <AnimatedVisualPlayer x:Name="LottiePlayer" AutoPlay="False" Stretch="Uniform" />
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="EditorProgressBarTemplate" TargetType="ProgressBar">
    <Grid x:Name="LayoutRoot" MinHeight="4">
      <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
        <VisualState x:Name="Normal" /><VisualState x:Name="Determinate" /><VisualState x:Name="Updating" /><VisualState x:Name="UpdatingError" />
        <VisualState x:Name="Error"><VisualState.Setters><Setter Target="DeterminateProgressBarIndicator.Fill" Value="{ThemeResource StudioDanger}" /></VisualState.Setters></VisualState>
        <VisualState x:Name="Paused"><VisualState.Setters><Setter Target="DeterminateProgressBarIndicator.Fill" Value="{ThemeResource StudioMuted}" /></VisualState.Setters></VisualState>
        <VisualState x:Name="Indeterminate">
          <VisualState.Setters><Setter Target="DeterminateProgressBarIndicator.Opacity" Value="0" /><Setter Target="IndeterminateProgressBarIndicator.Opacity" Value="1" /><Setter Target="IndeterminateProgressBarIndicator2.Opacity" Value="1" /></VisualState.Setters>
          <Storyboard RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="FirstTranslation" Storyboard.TargetProperty="X" From="{Binding TemplateSettings.ContainerAnimationStartPosition, RelativeSource={RelativeSource TemplatedParent}}" To="{Binding TemplateSettings.ContainerAnimationEndPosition, RelativeSource={RelativeSource TemplatedParent}}" Duration="0:0:1.5" />
            <DoubleAnimation Storyboard.TargetName="SecondTranslation" Storyboard.TargetProperty="X" From="{Binding TemplateSettings.Container2AnimationStartPosition, RelativeSource={RelativeSource TemplatedParent}}" To="{Binding TemplateSettings.Container2AnimationEndPosition, RelativeSource={RelativeSource TemplatedParent}}" BeginTime="0:0:0.5" Duration="0:0:1" />
          </Storyboard>
        </VisualState>
        <VisualState x:Name="IndeterminateError"><VisualState.Setters><Setter Target="DeterminateProgressBarIndicator.Opacity" Value="0" /><Setter Target="IndeterminateProgressBarIndicator2.Opacity" Value="1" /><Setter Target="IndeterminateProgressBarIndicator2.Fill" Value="{ThemeResource StudioDanger}" /></VisualState.Setters></VisualState>
        <VisualState x:Name="IndeterminatePaused"><VisualState.Setters><Setter Target="DeterminateProgressBarIndicator.Opacity" Value="0" /><Setter Target="IndeterminateProgressBarIndicator2.Opacity" Value="1" /><Setter Target="IndeterminateProgressBarIndicator2.Fill" Value="{ThemeResource StudioMuted}" /></VisualState.Setters></VisualState>
      </VisualStateGroup></VisualStateManager.VisualStateGroups>
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Clip="{Binding TemplateSettings.ClipRect, RelativeSource={RelativeSource TemplatedParent}}">
        <Grid>
          <Rectangle x:Name="DeterminateProgressBarIndicator" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
          <Rectangle x:Name="IndeterminateProgressBarIndicator" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" Opacity="0"><Rectangle.RenderTransform><TranslateTransform x:Name="FirstTranslation" /></Rectangle.RenderTransform></Rectangle>
          <Rectangle x:Name="IndeterminateProgressBarIndicator2" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" Opacity="0"><Rectangle.RenderTransform><TranslateTransform x:Name="SecondTranslation" /></Rectangle.RenderTransform></Rectangle>
        </Grid>
      </Border>
    </Grid>
  </ControlTemplate>
</ResourceDictionary>
