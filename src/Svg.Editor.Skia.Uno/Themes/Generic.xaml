<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Svg.Editor.Skia.Uno">
  <ResourceDictionary.MergedDictionaries><local:StudioThemeResources /></ResourceDictionary.MergedDictionaries>
  <Style TargetType="local:StudioIconButton">
    <Setter Property="MinWidth" Value="28" /><Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="6,3" /><Setter Property="FontSize" Value="{StaticResource StudioBodySize}" />
    <Setter Property="Foreground" Value="{ThemeResource StudioForeground}" /><Setter Property="Background" Value="Transparent" /><Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:StudioIconButton">
      <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{ThemeResource StudioBorder}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource StudioControlRadius}">
        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource StudioSelection}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioSelectionForeground}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource StudioSelection}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioSelectionForeground}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioDisabled}" /></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="local:StudioToolButton">
    <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
    <Setter Property="Width" Value="30" /><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="4" />
    <Setter Property="Foreground" Value="{ThemeResource StudioForeground}" /><Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:StudioToolButton">
      <Grid x:Name="Root" Background="Transparent" CornerRadius="{StaticResource StudioControlRadius}">
        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource StudioSelection}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioSelectionForeground}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource StudioSelection}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioSelectionForeground}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource StudioSelection}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioSelectionForeground}" /><Setter Target="SelectionMark.Opacity" Value="1" /></VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource StudioSelection}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioSelectionForeground}" /><Setter Target="SelectionMark.Opacity" Value="1" /></VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource StudioSelection}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioSelectionForeground}" /><Setter Target="SelectionMark.Opacity" Value="1" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioDisabled}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioDisabled}" /><Setter Target="SelectionMark.Opacity" Value="1" /></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        <Border x:Name="SelectionMark" Width="2" HorizontalAlignment="Left" Margin="0,7" Background="{ThemeResource StudioAccent}" Opacity="0" />
        <TextBlock Text="{TemplateBinding AlternateMark}" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,1" IsHitTestVisible="False" />
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="local:StudioTabButton">
    <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="12,5" />
    <Setter Property="FontSize" Value="{StaticResource StudioLabelSize}" /><Setter Property="Foreground" Value="{ThemeResource StudioMuted}" /><Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:StudioTabButton">
      <Grid x:Name="Root" Background="Transparent">
        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource StudioSelection}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioSelectionForeground}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource StudioSelection}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioSelectionForeground}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource StudioSurface}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioForeground}" /><Setter Target="ActiveLine.Opacity" Value="1" /></VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource StudioSelection}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioSelectionForeground}" /><Setter Target="ActiveLine.Opacity" Value="1" /></VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource StudioSelection}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioSelectionForeground}" /><Setter Target="ActiveLine.Opacity" Value="1" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioDisabled}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioDisabled}" /><Setter Target="ActiveLine.Opacity" Value="1" /></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        <Border x:Name="ActiveLine" Height="2" Margin="10,0" VerticalAlignment="Bottom" Background="{ThemeResource StudioAccent}" Opacity="0" />
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="StudioSectionHeader" TargetType="ToggleButton">
    <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="{StaticResource StudioLabelSize}" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource StudioForeground}" /><Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
      <Grid x:Name="Root" Background="Transparent" Padding="0,4" ColumnSpacing="6" CornerRadius="4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource StudioSelection}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioSelectionForeground}" /><Setter Target="Chevron.Stroke" Value="{ThemeResource StudioSelectionForeground}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource StudioSelection}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioSelectionForeground}" /><Setter Target="Chevron.Stroke" Value="{ThemeResource StudioSelectionForeground}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="ChevronRotation.Angle" Value="90" /></VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="ChevronRotation.Angle" Value="90" /><Setter Target="Root.Background" Value="{ThemeResource StudioSelection}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioSelectionForeground}" /><Setter Target="Chevron.Stroke" Value="{ThemeResource StudioSelectionForeground}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="ChevronRotation.Angle" Value="90" /><Setter Target="Root.Background" Value="{ThemeResource StudioSelection}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioSelectionForeground}" /><Setter Target="Chevron.Stroke" Value="{ThemeResource StudioSelectionForeground}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioDisabled}" /><Setter Target="Chevron.Stroke" Value="{ThemeResource StudioDisabled}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="ChevronRotation.Angle" Value="90" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioDisabled}" /><Setter Target="Chevron.Stroke" Value="{ThemeResource StudioDisabled}" /></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <Path x:Name="Chevron" Data="M0,0 L4,4 L0,8" Width="4" Height="8" Stroke="{ThemeResource StudioMuted}" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
          <Path.RenderTransform><RotateTransform x:Name="ChevronRotation" CenterX="2" CenterY="4" /></Path.RenderTransform>
        </Path>
        <ContentPresenter x:Name="Presenter" Grid.Column="1" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="local:StudioSection">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:StudioSection">
      <StackPanel Spacing="8">
        <ToggleButton x:Name="PART_Header" Content="{TemplateBinding Header}" IsChecked="True" Style="{StaticResource StudioSectionHeader}" />
        <ContentPresenter x:Name="PART_Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" Margin="0,0,0,12" />
        <Border Height="1" Background="{ThemeResource StudioDivider}" />
      </StackPanel>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="local:StudioNumericField">
    <Setter Property="MinHeight" Value="32" /><Setter Property="MinWidth" Value="0" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:StudioNumericField">
      <Grid ColumnSpacing="6" VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{TemplateBinding Header}" MinWidth="14" VerticalAlignment="Center" FontSize="{StaticResource StudioLabelSize}" Foreground="{ThemeResource StudioMuted}" />
        <NumberBox x:Name="PART_Number" Grid.Column="1" Style="{StaticResource StudioNumberBoxStyle}" MinWidth="56" MinHeight="28" FontSize="12" Padding="6,3" AcceptsExpression="True" SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" HorizontalAlignment="Stretch" />
        <TextBlock Grid.Column="2" Text="{TemplateBinding Suffix}" VerticalAlignment="Center" FontSize="10" Foreground="{ThemeResource StudioMuted}" />
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="local:StudioPaintChip">
    <Setter Property="MinHeight" Value="32" /><Setter Property="MinWidth" Value="68" />
    <Setter Property="Foreground" Value="{ThemeResource StudioForeground}" /><Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:StudioPaintChip">
      <Border x:Name="Root" Background="{ThemeResource StudioInputBackground}" BorderBrush="{ThemeResource StudioBorder}" BorderThickness="1" CornerRadius="{StaticResource StudioControlRadius}" Padding="6,4">
        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.BorderBrush" Value="{ThemeResource StudioAccent}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.BorderBrush" Value="{ThemeResource StudioAccent}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Label.Foreground" Value="{ThemeResource StudioDisabled}" /></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
          <Border Width="20" Height="20" BorderBrush="{ThemeResource StudioBorder}" BorderThickness="1">
            <Grid Background="{ThemeResource StudioSurface}">
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Rectangle Fill="{ThemeResource StudioBorder}" /><Rectangle Grid.Row="1" Grid.Column="1" Fill="{ThemeResource StudioBorder}" />
              <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{TemplateBinding Swatch}" />
              <TextBlock Grid.RowSpan="2" Grid.ColumnSpan="2" Text="{TemplateBinding Mark}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <TextBlock x:Name="Label" Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" Visibility="{TemplateBinding LabelVisibility}" FontSize="11" VerticalAlignment="Center" />
          <TextBlock Text="⌄" Visibility="{TemplateBinding LabelVisibility}" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="local:StudioSplitter">
    <Setter Property="Background" Value="{ThemeResource StudioHeader}" /><Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:StudioSplitter">
      <Grid x:Name="Root" Background="{TemplateBinding Background}">
        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource StudioAccent}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource StudioAccent}" /></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="local:StudioDockGroup">
    <Setter Property="Foreground" Value="{ThemeResource StudioForeground}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:StudioDockGroup">
      <Border Background="{ThemeResource StudioSurface}" BorderBrush="{ThemeResource StudioDivider}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Background="{ThemeResource StudioHeader}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
            <Thumb x:Name="PART_Grip" IsTabStop="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent" /></ControlTemplate></Thumb.Template></Thumb>
            <TextBlock Text="{TemplateBinding Caption}" Margin="12,0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
            <Button x:Name="PART_Collapse" Grid.Column="1" Content="−" Style="{StaticResource StudioQuietButtonStyle}" MinWidth="0" MinHeight="26" Padding="0" FontSize="12" />
            <Button x:Name="PART_Menu" Grid.Column="2" Content="⋯" Style="{StaticResource StudioQuietButtonStyle}" MinWidth="0" MinHeight="26" Padding="0" FontSize="14" AutomationProperties.Name="Panel docking and tab menu" />
          </Grid>
          <Grid Grid.Row="1" Background="{ThemeResource StudioHeader}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="PART_PreviousTabs" Content="‹" Width="24" MinWidth="0" MinHeight="30" Padding="0" FontSize="18" Style="{StaticResource StudioQuietButtonStyle}" Visibility="Collapsed" AutomationProperties.Name="Scroll panel tabs backward" ToolTipService.ToolTip="Show earlier panel tabs" />
            <ScrollViewer x:Name="PART_TabScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
              <StackPanel x:Name="PART_Tabs" Orientation="Horizontal" />
            </ScrollViewer>
            <Button x:Name="PART_NextTabs" Grid.Column="2" Content="›" Width="24" MinWidth="0" MinHeight="30" Padding="0" FontSize="18" Style="{StaticResource StudioQuietButtonStyle}" Visibility="Collapsed" AutomationProperties.Name="Scroll panel tabs forward" ToolTipService.ToolTip="Show later panel tabs" />
            <Button x:Name="PART_PanelPicker" Grid.Column="3" Content="⌄" Width="28" MinWidth="0" MinHeight="30" Padding="0" Style="{StaticResource StudioQuietButtonStyle}" AutomationProperties.Name="Choose panel" ToolTipService.ToolTip="Choose any panel in this group" />
          </Grid>
          <Grid x:Name="PART_Content" Grid.Row="2" />
        </Grid>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
