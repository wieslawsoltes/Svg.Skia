<ResourceDictionary x:Class="Svg.Editor.Skia.Uno.StudioThemeResources"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Svg.Editor.Skia.Uno">
  <ResourceDictionary.MergedDictionaries><local:StudioPaletteResources /></ResourceDictionary.MergedDictionaries>

  <!-- Lightweight native styling: keep platform editing, IME, selection and automation. -->
  <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource StudioInputColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource StudioInputColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource StudioInputColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{ThemeResource StudioHeaderColor}" />
  <SolidColorBrush x:Key="TextControlForeground" Color="{ThemeResource StudioForegroundColor}" />
  <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{ThemeResource StudioForegroundColor}" />
  <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{ThemeResource StudioForegroundColor}" />
  <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{ThemeResource StudioDisabledColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource StudioMutedColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{ThemeResource StudioMutedColor}" />
  <SolidColorBrush x:Key="TextControlHeaderForeground" Color="{ThemeResource StudioMutedColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="{ThemeResource StudioBorderColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{ThemeResource StudioMutedColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource StudioAccentColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{ThemeResource StudioDividerColor}" />
  <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">2</Thickness>
  <Thickness x:Key="TextBoxTopHeaderMargin">0,0,0,6</Thickness>
  <Thickness x:Key="ComboBoxTopHeaderMargin">0,0,0,6</Thickness>
  <Thickness x:Key="NumberBoxTopHeaderMargin">0,0,0,6</Thickness>
  <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
  <x:Double x:Key="TextControlThemeMinHeight">32</x:Double>
  <x:Double x:Key="NumberBoxMinWidth">0</x:Double>
  <x:Double x:Key="ComboBoxThemeMinWidth">0</x:Double>
  <x:Double x:Key="ComboBoxThemeMinHeight">32</x:Double>
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>
  <SolidColorBrush x:Key="ComboBoxBackground" Color="{ThemeResource StudioInputColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{ThemeResource StudioHoverColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{ThemeResource StudioSelectionColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{ThemeResource StudioHeaderColor}" />
  <SolidColorBrush x:Key="ComboBoxForeground" Color="{ThemeResource StudioForegroundColor}" />
  <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="{ThemeResource StudioForegroundColor}" />
  <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="{ThemeResource StudioSelectionForegroundColor}" />
  <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{ThemeResource StudioDisabledColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{ThemeResource StudioBorderColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{ThemeResource StudioMutedColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{ThemeResource StudioAccentColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{ThemeResource StudioRaisedColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="{ThemeResource StudioForegroundColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{ThemeResource StudioBorderColor}" />
  <SolidColorBrush x:Key="ComboBoxHeaderForeground" Color="{ThemeResource StudioMutedColor}" />
  <SolidColorBrush x:Key="NumberBoxPopupBackground" Color="{ThemeResource StudioRaisedColor}" />
  <SolidColorBrush x:Key="NumberBoxPopupBorderBrush" Color="{ThemeResource StudioBorderColor}" />
  <SolidColorBrush x:Key="NumberBoxPopupIndicatorForeground" Color="{ThemeResource StudioMutedColor}" />
  <SolidColorBrush x:Key="ContentDialogBackground" Color="{ThemeResource StudioSurfaceColor}" />
  <SolidColorBrush x:Key="ContentDialogForeground" Color="{ThemeResource StudioForegroundColor}" />
  <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{ThemeResource StudioBorderColor}" />
  <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="{ThemeResource StudioSurfaceColor}" />
  <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="{ThemeResource StudioDividerColor}" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{ThemeResource StudioRaisedColor}" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{ThemeResource StudioBorderColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{ThemeResource StudioForegroundColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{ThemeResource StudioSelectionColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{ThemeResource StudioSelectionForegroundColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="{ThemeResource StudioDisabledColor}" />
  <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource StudioSelectionColor}" />
  <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource StudioHoverColor}" />
  <SolidColorBrush x:Key="ListViewItemForeground" Color="{ThemeResource StudioForegroundColor}" />
  <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="{ThemeResource StudioSelectionForegroundColor}" />
  <x:Double x:Key="ListViewItemMinHeight">30</x:Double>
  <Thickness x:Key="ContentDialogPadding">24</Thickness>
  <Thickness x:Key="ContentDialogButtonSpacing">8</Thickness>

  <DataTemplate x:Key="StudioFieldHeaderTemplate">
    <TextBlock Text="{Binding}" FontSize="{StaticResource StudioLabelSize}" FontWeight="SemiBold"
               Foreground="{ThemeResource StudioMuted}" TextWrapping="Wrap" Margin="0,0,0,2" />
  </DataTemplate>
  <Style x:Key="StudioTextBoxStyle" TargetType="TextBox">
    <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="{StaticResource StudioControlHeight}" />
    <Setter Property="FontSize" Value="{StaticResource StudioBodySize}" /><Setter Property="Padding" Value="{StaticResource StudioControlPadding}" />
    <Setter Property="Background" Value="{ThemeResource StudioInputBackground}" /><Setter Property="Foreground" Value="{ThemeResource StudioForeground}" />
    <Setter Property="BorderBrush" Value="{ThemeResource StudioBorder}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource StudioControlRadius}" />
    <Setter Property="HeaderTemplate" Value="{StaticResource StudioFieldHeaderTemplate}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource StudioTextBoxStyle}" />
  <Style x:Key="StudioNumberBoxStyle" TargetType="NumberBox">
    <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="{StaticResource StudioControlHeight}" />
    <Setter Property="FontSize" Value="{StaticResource StudioBodySize}" /><Setter Property="Padding" Value="8,4" />
    <Setter Property="Foreground" Value="{ThemeResource StudioForeground}" /><Setter Property="Background" Value="{ThemeResource StudioInputBackground}" />
    <Setter Property="BorderBrush" Value="{ThemeResource StudioBorder}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource StudioControlRadius}" />
    <Setter Property="HeaderTemplate" Value="{StaticResource StudioFieldHeaderTemplate}" /><Setter Property="AcceptsExpression" Value="True" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style TargetType="NumberBox" BasedOn="{StaticResource StudioNumberBoxStyle}" />
  <Style x:Key="StudioComboBoxStyle" TargetType="ComboBox">
    <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="{StaticResource StudioControlHeight}" />
    <Setter Property="FontSize" Value="{StaticResource StudioBodySize}" /><Setter Property="Padding" Value="10,5" />
    <Setter Property="Foreground" Value="{ThemeResource StudioForeground}" /><Setter Property="Background" Value="{ThemeResource StudioInputBackground}" />
    <Setter Property="BorderBrush" Value="{ThemeResource StudioBorder}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource StudioControlRadius}" />
    <Setter Property="HeaderTemplate" Value="{StaticResource StudioFieldHeaderTemplate}" /><Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource StudioComboBoxStyle}" />

  <Style x:Key="StudioButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="{StaticResource StudioControlHeight}" />
    <Setter Property="Padding" Value="{StaticResource StudioControlPadding}" /><Setter Property="FontSize" Value="{StaticResource StudioBodySize}" />
    <Setter Property="Foreground" Value="{ThemeResource StudioForeground}" /><Setter Property="Background" Value="{ThemeResource StudioRaised}" />
    <Setter Property="BorderBrush" Value="{ThemeResource StudioBorder}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource StudioControlRadius}" /><Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid x:Name="Root">
        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Chrome.Background" Value="{ThemeResource StudioSelection}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioSelectionForeground}" /><Setter Target="Chrome.BorderBrush" Value="{ThemeResource StudioAccent}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Chrome.Background" Value="{ThemeResource StudioSelection}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioSelectionForeground}" /><Setter Target="Chrome.BorderBrush" Value="{ThemeResource StudioAccent}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Presenter.Foreground" Value="{ThemeResource StudioDisabled}" /><Setter Target="Chrome.Background" Value="{ThemeResource StudioHeader}" /><Setter Target="Chrome.BorderBrush" Value="{ThemeResource StudioDivider}" /></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTransitions="{TemplateBinding ContentTransitions}"
                            Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource StudioButtonStyle}" />
  <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource StudioButtonStyle}">
    <Setter Property="MinHeight" Value="{StaticResource StudioCompactHeight}" /><Setter Property="Padding" Value="{StaticResource StudioCompactPadding}" />
  </Style>
  <Style x:Key="StudioPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource StudioButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource StudioAccent}" /><Setter Property="Foreground" Value="{ThemeResource StudioOnAccent}" />
    <Setter Property="BorderBrush" Value="{ThemeResource StudioAccent}" /><Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="StudioQuietButtonStyle" TargetType="Button" BasedOn="{StaticResource StudioButtonStyle}">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style x:Key="StudioDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource StudioButtonStyle}">
    <Setter Property="Foreground" Value="{ThemeResource StudioDanger}" />
  </Style>
  <Style TargetType="CheckBox"><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="28" /><Setter Property="FontSize" Value="{StaticResource StudioBodySize}" /><Setter Property="Foreground" Value="{ThemeResource StudioForeground}" /></Style>
  <Style TargetType="RadioButton"><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="28" /><Setter Property="FontSize" Value="{StaticResource StudioBodySize}" /><Setter Property="Foreground" Value="{ThemeResource StudioForeground}" /></Style>
  <Style TargetType="ToggleSwitch"><Setter Property="MinWidth" Value="0" /><Setter Property="FontSize" Value="{StaticResource StudioBodySize}" /><Setter Property="Foreground" Value="{ThemeResource StudioForeground}" /></Style>
  <Style TargetType="MenuFlyoutItem"><Setter Property="FontSize" Value="{StaticResource StudioBodySize}" /><Setter Property="Padding" Value="12,7" /></Style>
  <Style TargetType="MenuFlyoutSubItem"><Setter Property="FontSize" Value="{StaticResource StudioBodySize}" /><Setter Property="Padding" Value="12,7" /></Style>
  <Style TargetType="ListViewItem"><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="8,5" /><Setter Property="FontSize" Value="{StaticResource StudioBodySize}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
  <Style TargetType="ContentDialog"><Setter Property="Foreground" Value="{ThemeResource StudioForeground}" /><Setter Property="Background" Value="{ThemeResource StudioSurface}" /><Setter Property="FontSize" Value="{StaticResource StudioBodySize}" /><Setter Property="CornerRadius" Value="{StaticResource StudioSurfaceRadius}" /></Style>
  <Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource StudioLabelSize}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{ThemeResource StudioMuted}" /><Setter Property="Margin" Value="0,8,0,4" /></Style>
  <Style x:Key="StudioHintStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource StudioLabelSize}" /><Setter Property="Foreground" Value="{ThemeResource StudioMuted}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
</ResourceDictionary>
